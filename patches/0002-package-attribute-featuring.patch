+    steps: &mut usize,
+) -> bool {
+    let Some(rows) = raw.nonowned_bases.get(&source) else {
+        return false;
+    };
+    if rows.is_empty() || charge(steps, rows.len()).is_none() {
+        return false;
+    }
+    for &row in rows {
+        let (source_kind, source_keys, target_keys, target_kind): (&str, &[&str], &[&str], &str) =
