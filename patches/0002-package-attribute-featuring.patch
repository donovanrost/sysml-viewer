+    fn package_attribute() -> (ResolvedModel, usize) {
+        let mut m = Model::new();
+        m.add_source("attribute.sysml", "package P { attribute count = 3; }");
+        assert!(!m.has_errors());
+        let mut r = ResolvedModel::build(&m);
+        let f = r.resolve_qualified("P::count").unwrap().0;
+        (r, f)
+    }
+
+    #[test]
+    fn package_attribute_featuring_checks_inverse_relations() {
+        let (mut r, f) = package_attribute();
+        let mut proof = TypeRelations::default();
+        assert_eq!(
+            proof.audited_featuring_domain(&mut r.b, &[f], &mut 0),
+            Some(true)
+        );
+        assert_eq!(proof.featuring_types(&mut r.b, f, &mut 0), Some(vec![]));
+
+        let mut m = Model::new();
+        m.add_source("attribute.sysml", "package P { attribute count = 3; }");
+        m.add_source("featuring.kerml", "class C; featuring P::count by C;");
+        assert!(!m.has_errors());
+        let mut r = ResolvedModel::build(&m);
+        let f = r.resolve_qualified("P::count").unwrap().0;
+        let c = r.resolve_qualified("C").unwrap().0;
+        let mut proof = TypeRelations::default();
+        assert_eq!(
+            proof.audited_featuring_domain(&mut r.b, &[f], &mut 0),
+            Some(true)
+        );
+        assert_eq!(proof.featuring_types(&mut r.b, f, &mut 0), Some(vec![c]));
+    }
+
+    #[test]
+    fn package_attribute_featuring_refuses_variable_variant_and_malformed_evidence() {
+        for (key, value) in [
+            ("isVariable", serde_json::json!(true)),
+            ("isVariable", serde_json::json!("false")),
+            ("isVariation", serde_json::json!(true)),
+            ("isVariation", serde_json::Value::Null),
+        ] {
+            let (mut r, f) = package_attribute();
+            r.b.set(f, key, value);
+            assert_ne!(
+                TypeRelations::default().audited_featuring_domain(&mut r.b, &[f], &mut 0),
+                Some(true)
+            );
+        }
+        for mutation in 0..5 {
+            let (mut r, f) = package_attribute();
+            let rel = r.b.elements[f].owning_relationship.unwrap();
+            let owner = r.b.owner_elem(f).unwrap();
+            match mutation {
+                0 => r.b.elements[rel].ty = "VariantMembership",
+                1 => r.b.elements[owner].ty = "Class",
+                2 => r.b.elements[f].owning_relationship = Some(r.b.elements.len()),
+                3 => {
+                    let wrong = r.b.elem_id(owner);
+                    r.b.set(rel, "memberElement", id_ref(wrong));
+                }
+                _ => {
+                    let wrong = r.b.elem_id(f);
+                    r.b.set(rel, "owningRelatedElement", id_ref(wrong));
+                }
+            }
+            assert_ne!(
+                TypeRelations::default().audited_featuring_domain(&mut r.b, &[f], &mut 0),
+                Some(true),
+                "mutation {mutation}"
+            );
+        }
+    }
+
+    #[test]
+    fn package_attribute_featuring_budget_exhaustion_can_retry() {
+        let (mut r, f) = package_attribute();
+        let mut proof = TypeRelations::default();
+        let mut steps = crate::eval::MAX_STEPS;
+        assert_eq!(
+            proof.audited_featuring_domain(&mut r.b, &[f], &mut steps),
+            None
+        );
+        assert_eq!(
+            TypeRelations::default().audited_featuring_domain(&mut r.b, &[f], &mut 0),
+            Some(true)
+        );
+    }
