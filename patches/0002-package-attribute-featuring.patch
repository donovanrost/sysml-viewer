+                (
+                    "Classifier",
+                    &["subclassifier", "specific"],
+                    &["superclassifier", "general"],
+                    "Classifier",
+                )
+            } else {
+                return false;
+            };
+        if !conforms(b.elements[source].ty, source_kind)
+            || semantic_ownership::checked_relationship_carrier(b, raw, row, steps) != Some(None)
+            || endpoint_with_carrier(
+                b,
+                source,
+                None,
+                row,
+                source_keys,
+                target_keys,
+                target_kind,
+                steps,
+            )
+            .is_none()
