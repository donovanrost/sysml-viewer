+/// A canonical conditional argument owns a reference to an Expression. Do not
+/// reinterpret a plain Feature reference, missing wrapper or broken reciprocal
+/// membership as a deferred expression. Both branches require this evidence.
+fn conditional_operand(
+    b: &Builder,
+    raw: &StoredStructure,
+    reference: usize,
+    steps: &mut usize,
+) -> Result<usize, CardinalityIssue> {
+    if b.elements[reference].ty != "FeatureReferenceExpression"
+        || raw.metadata_annotation_targets.contains(&reference)
+        || b.metadata_of.get(&reference).is_some_and(|m| !m.is_empty())
+    {
+        return Err(CardinalityIssue::UnsupportedBound);
+    }
+    certify_reference_domain(b, raw, reference, steps)?;
+    let relationships = semantic_ownership::owned_relationships(b, reference)
+        .ok_or(CardinalityIssue::InvalidRelationship)?;
+    let mut expression = None;
+    for relationship in relationships.iter() {
+        charge(steps, 1)?;
+        let kind = b.elements[relationship].ty;
+        if !conforms(kind, "Membership") || conforms(kind, "ParameterMembership") {
+            continue;
+        }
+        let target = membership_evidence::member(b, raw, reference, relationship, steps)
+            .ok_or(CardinalityIssue::InvalidRelationship)?;
+        if kind != "FeatureMembership"
+            || !conforms(b.elements[target].ty, "Expression")
+            || b.elements[target].owning_relationship != Some(relationship)
+            || expression.replace(target).is_some()
+        {
+            return Err(CardinalityIssue::InvalidRelationship);
+        }
+        if raw.metadata_annotation_targets.contains(&target)
+            || b.metadata_of.get(&target).is_some_and(|m| !m.is_empty())
+        {
+            return Err(CardinalityIssue::IncompleteProvider);
+        }
+    }
+    expression.ok_or(CardinalityIssue::InvalidRelationship)
 }
 
