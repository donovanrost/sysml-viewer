+
+/// The Boolean control functions share a deferred second operand, but differ
+/// in which first value makes that operand unnecessary. Use this rule in both
+/// execution certification and execution, without caching a computed value.
+#[derive(Clone, Copy)]
+pub(crate) enum CheckedLogicalOperator {
+    And,
+    Or,
+    Implies,
+}
+impl CheckedLogicalOperator {
+    pub(crate) fn short_circuit(self, first: bool) -> Option<bool> {
+        match (self, first) {
+            (Self::And, false) => Some(false),
+            (Self::Or, true) | (Self::Implies, false) => Some(true),
+            _ => None,
+        }
+    }
+}
+
+/// Select a conditional branch with the same exact, bounded graph evaluator.
+/// Integers and unknown values are never coerced to Boolean truth values.
+pub(crate) fn checked_multiplicity_condition(
+    b: &mut Builder,
+    expression: usize,
+    context: Option<usize>,
+    operators: &CheckedMultiplicityExpressions,
+    steps: &mut usize,
+) -> Option<bool> {
+    let mut evaluator = checked_multiplicity_evaluator(b, *steps);
+    let result = evaluator.certified_multiplicity_value(expression, context, operators, 0);
+    *steps = evaluator.steps;
+    match result? {
+        Value::Boolean(value) => Some(value),
+        _ => None,
+    }
+}
+
+/// Known emptiness selects a coalescing fallback. Failed or unavailable
+/// evaluation remains None, never an empty value.
+pub(crate) fn checked_multiplicity_empty(
+    b: &mut Builder,
+    expression: usize,
+    context: Option<usize>,
+    operators: &CheckedMultiplicityExpressions,
+    steps: &mut usize,
+) -> Option<bool> {
+    let mut evaluator = checked_multiplicity_evaluator(b, *steps);
+    let result = evaluator.certified_multiplicity_value(expression, context, operators, 0);
+    *steps = evaluator.steps;
+    Some(result?.is_null())
 }
 
