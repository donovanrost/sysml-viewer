+    fn unresolved_specialization_fixture(generic: bool) -> ResolvedModel {
+        let mut model =
+            crate::model::Model::with_graph_format(crate::model::GraphFormat::CanonicalV3);
+        model.add_library_source("isolation-library.kerml", ISOLATION_LIB);
