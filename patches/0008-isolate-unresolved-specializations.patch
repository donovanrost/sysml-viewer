+/// An unresolved target can be isolated only when every available source alias
+/// identifies the same local Type. A contradictory source could affect another
+/// component, so it must still refuse the complete batch. Carrier identity is
+/// separately certified by the shared semantic ownership reader.
+fn consistent_unresolved_source(
+    b: &Builder,
+    relation: usize,
+    source: usize,
+    carrier: Option<usize>,
+    steps: &mut usize,
+) -> Result<bool, Refusal> {
+    let node = &b.elements[relation];
+    let source_id = b.elements[source].id;
+    for key in [
+        "specific",
+        "subclassifier",
+        "typedFeature",
+        "subsettingFeature",
+        "redefiningFeature",
+        "referencingFeature",
+        "crossingFeature",
+    ] {
+        charge(steps, 1)?;
+        if node
+            .props
+            .get(key)
+            .is_some_and(|v| v.as_reference() != Some(source_id))
+        {
+            return Ok(false);
+        }
+    }
+    if node
+        .props
+        .get("owningRelatedElement")
+        .is_some_and(|v| v.as_reference() != carrier.map(|owner| b.elements[owner].id))
+    {
+        return Ok(false);
+    }
+    for (key, length) in [("source", 1), ("relatedElement", 2)] {
+        if let Some(value) = node.props.get(key) {
+            let Some(values) = value.as_array() else {
+                return Ok(false);
+            };
+            charge(steps, values.len())?;
+            if values.len() != length || values[0].as_reference() != Some(source_id) {
+                return Ok(false);
+            }
+        }
+    }
+    Ok(true)
+}
