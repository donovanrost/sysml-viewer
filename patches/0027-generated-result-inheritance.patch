+    #[test]
+    fn source_conjugation_subclasses_cannot_certify_generated_result_domains() {
+        use crate::model::GraphFormat;
+        for kind in ["Conjugation", "PortConjugation"] {
+            let mut model = Model::with_graph_format(GraphFormat::CanonicalV3);
+            model.add_library_source("reference-library.kerml", LIB);
+            model.add_source("reference-user.kerml", "feature n;feature x=n;");
+            let mut r = ResolvedModel::build(&model);
+            let expression = r
+                .user_elements()
+                .find(|&e| r.element_type(e) == "FeatureReferenceExpression")
+                .unwrap();
+            let target = r.resolve_qualified("Performances::evaluations").unwrap();
+            let relationship = r.b.new_relationship(kind, expression.0, "conjugation");
+            r.b.set(
+                relationship,
+                "conjugatedType",
+                json!({"@id":r.element_id(expression)}),
+            );
+            r.b.set(
+                relationship,
+                "originalType",
+                json!({"@id":r.element_id(target)}),
+            );
+            r.implied_relationships(expression);
+            let result =
+                r.b.semantic_ownership
+                    .as_ref()
+                    .unwrap()
+                    .result(expression.0)
+                    .unwrap()
+                    .feature;
+            assert!(
+                r.b.complete_generated_reference_result(result, &mut 0)
+                    .is_none(),
+                "{kind}"
+            );
+            assert!(
+                r.type_feature_report(ElementRef(result))
+                    .projections
+                    .is_err(),
+                "{kind}"
+            );
+        }
+    }
+    #[test]
+    fn missing_expression_specialization_does_not_certify_an_empty_result_domain() {
+        use crate::model::GraphFormat;
+        for missing_role in [false, true] {
+            let mut m = Model::with_graph_format(GraphFormat::CanonicalV3);
+            m.add_library_source(
+                "reference-library.kerml",
+                &if missing_role {
+                    LIB.replace("expr evaluations:Evaluation subsets performances;", "")
+                } else {
+                    LIB.to_owned()
+                },
+            );
+            m.add_source("reference-user.kerml", "feature n;feature x=n;");
+            let mut r = ResolvedModel::build(&m);
+            let expression = r
+                .user_elements()
+                .find(|&e| r.element_type(e) == "FeatureReferenceExpression")
+                .unwrap();
+            let evaluation = r.resolve_qualified("Performances::Evaluation").unwrap();
+            let typing =
+                r.b.new_relationship("FeatureTyping", expression.0, "canonical-base");
+            r.b.set(
+                typing,
+                "typedFeature",
+                json!({"@id":r.element_id(expression)}),
+            );
+            r.b.set(typing, "type", json!({"@id":r.element_id(evaluation)}));
+            r.implied_relationships(expression);
+            let result = ElementRef(
+                r.b.semantic_ownership
+                    .as_ref()
+                    .unwrap()
+                    .result(expression.0)
+                    .unwrap()
+                    .feature,
+            );
+            assert!(
+                r.b.dynamic_graph
+                    .as_ref()
+                    .unwrap()
+                    .result_redefinition
+                    .as_ref()
+                    .unwrap()
+                    .sources
+                    .contains(&result.0)
+            );
+            assert_eq!(
+                r.type_feature_report(result).projections.is_err(),
+                missing_role
+            );
+        }
+    }
+    #[test]
+    fn complete_empty_generated_domain_is_not_a_missing_dependency_fallback() {
+        use crate::model::GraphFormat;
+        for format in [GraphFormat::CanonicalV3, GraphFormat::LegacyV2] {
+            let (mut r, _, result) = checked_fixture(format, "feature n;feature x=n;");
+            let report = r.type_feature_report(result).projections.unwrap();
+            assert!(report.features.is_empty());
+            assert!(report.members.unwrap().is_empty());
+            let (mut r, _, result) = checked_fixture(format, "feature n:Missing;feature x=n;");
+            assert!(r.type_feature_report(result).projections.is_err());
+        }
+    }
+}
