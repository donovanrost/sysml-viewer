+//! Identity-based inheritance for materialized expression results without body scopes.
+//! Compatibility inheritance and complete recipe admission share current identities.
+//! Complete Type.feature queries still use the central checked membership reducer;
+//! this adapter only proves the generated owner's domain and required result bases.
+use super::{
+    Builder, MembershipContext, MembershipProjection, implied, membership_evidence,
+    semantic_ownership, structural_index::StoredStructure, type_relations,
+};
+
+impl Builder {
+    /// Shape admission only. Complete queries separately certify the current recipe.
+    pub(super) fn is_generated_reference_result(&self, element: usize) -> bool {
+        self.semantic_ownership.as_ref().is_some_and(|view| {
+            let anchor = view.source_anchor(element);
+            view.matches_suffix(self)
+                && view.contains(element)
+                && view
+                    .result(anchor)
+                    .is_some_and(|result| result.feature == element)
+                && self
+                    .elements
+                    .get(anchor)
+                    .is_some_and(|row| row.ty == "FeatureReferenceExpression")
+        })
+    }
+
+    /// Certify the complete generated result recipe without fabricating a body
+    /// scope or treating a positive canonical return witness as proof of absence.
+    pub(super) fn complete_generated_reference_result(
+        &mut self,
+        element: usize,
+        steps: &mut usize,
+    ) -> Option<usize> {
+        *steps = steps.saturating_add(1);
+        if *steps > crate::eval::MAX_STEPS || !self.is_generated_reference_result(element) {
+            return None;
+        }
+        let snapshot = self.dynamic_graph.as_ref()?;
+        if !snapshot.result_redefinition_current(self) || !snapshot.local_current(self) {
+            return None;
+        }
+        let evidence = snapshot.result_redefinition.as_ref()?.clone();
+        if !evidence.sources.contains(&element) {
+            return None;
+        }
+        let canonical_result = evidence.canonical_result?;
+        let bases = self.checked_generated_result_bases(element, steps)?;
+        if !bases.contains(&canonical_result) {
+            return None;
+        }
+        let anchor = self.semantic_ownership.as_ref()?.source_anchor(element);
+        let raw = StoredStructure::for_query(self, steps)?;
+        if !raw.membership_domains(self, steps)?.owner_complete(anchor)
+            || raw.annotations_incomplete
+            || self.metadata_associations_incomplete
+            || [element, anchor].iter().any(|owner| {
+                raw.metadata_annotation_targets.contains(owner)
+                    || self.metadata_of.get(owner).is_some_and(|m| !m.is_empty())
+            })
+        {
+            return None;
+        }
+        // Conditional Feature families are absent from this immutable construction
+        // recipe. Do not generalize the certificate to arbitrary implied Features.
+        for key in [
+            "isEnd",
+            "isPortion",
+            "isComposite",
+            "isVariable",
+            "isConjugated",
+        ] {
+            if self.elements[element]
+                .props
+                .get(key)
+                .is_some_and(|v| v.as_bool() != Some(false))
+            {
+                return None;
+            }
+        }
+        for key in [
+            "isEnd",
+            "isPortion",
+            "isComposite",
+            "isVariable",
+            "isConjugated",
+        ] {
+            if self.elements[anchor]
+                .props
+                .get(key)
+                .is_some_and(|v| v.as_bool() != Some(false))
+            {
+                return None;
+            }
+        }
+        let relationships = semantic_ownership::owned_relationships(self, anchor)?;
+        *steps = steps.saturating_add(relationships.len());
+        if *steps > crate::eval::MAX_STEPS {
+            return None;
+        }
+        let relationships: Vec<_> = relationships.iter().collect();
+        let mut seen = std::collections::HashSet::new();
+        let mut found_canonical = false;
+        for relationship in relationships {
+            if !seen.insert(relationship) {
+                return None;
+            }
+            let kind = self.elements.get(relationship)?.ty;
+            if semantic_ownership::checked_relationship_carrier(self, &raw, relationship, steps)?
+                != Some(anchor)
+            {
+                return None;
+            }
+            if crate::metaclass::conforms(kind, "Conjugation")
+                || crate::metaclass::conforms(kind, "FeatureChaining")
+            {
+                return None;
+            }
+            if !crate::metaclass::conforms(kind, "Specialization") {
+                continue;
+            }
+            let target = type_relations::endpoint_with_carrier(
+                self,
+                anchor,
+                Some(anchor),
+                relationship,
+                &[
+                    "specific",
+                    "typedFeature",
+                    "subsettingFeature",
+                    "redefiningFeature",
+                ],
+                &["general", "type", "subsettedFeature", "redefinedFeature"],
+                "Type",
+                steps,
+            )?;
+            if crate::metaclass::conforms(self.elements[target].ty, "Function")
+                || crate::metaclass::conforms(self.elements[target].ty, "Expression")
+            {
+                if !evidence.canonical_bases.contains(&target) {
+                    return None;
+                }
+                found_canonical = true;
+            }
+        }
+        found_canonical.then_some(anchor)
+    }
+    pub(super) fn scope_less_inherited_memberships(
+        &mut self,
+        element: usize,
+        include_implied: bool,
+    ) -> MembershipProjection {
+        if self
+            .elements
+            .get(element)
+            .is_some_and(|e| implied::literal_implied_base(e.ty).is_some())
+        {
+            return self.literal_inherited_memberships(element, include_implied);
+        }
+        let Some(view) = &self.semantic_ownership else {
+            return MembershipProjection::default();
+        };
+        let anchor = view.source_anchor(element);
+        if view
+            .result(anchor)
+            .is_none_or(|result| result.feature != element)
+        {
+            return MembershipProjection::default();
+        }
+        let mut context = MembershipContext::default();
+        self.generated_result_inheritance(element, include_implied, &mut context)
+    }
+
+    fn generated_result_inheritance(
+        &mut self,
+        element: usize,
+        include_implied: bool,
+        context: &mut MembershipContext,
+    ) -> MembershipProjection {
+        let checked = self.checked_generated_result_bases(element, &mut context.steps);
+        if checked.is_none() {
+            return MembershipProjection {
+                incomplete: true,
+                truncated: context.steps > crate::eval::MAX_STEPS,
+                ..Default::default()
+            };
+        }
+        let family = context.new_type_family();
+        let inherited = self.contextual_inherited_bindings(
+            element,
+            include_implied,
+            &[],
+            &[],
+            family,
+            context,
+            0,
+        );
+        // A warm positional cache can expose known bases even when no loaded
+        // Evaluation.result witness was available at publication. That does not
+        // make the missing required return redefinition complete on a later read.
+        let required_result_ready = !include_implied
+            || self.dynamic_graph.as_ref().is_some_and(|snapshot| {
+                snapshot.result_redefinition_current(self)
+                    && snapshot
+                        .result_redefinition
+                        .as_ref()
+                        .is_some_and(|evidence| evidence.sources.contains(&element))
+            });
+        MembershipProjection {
+            membership_order: inherited.membership_order.clone(),
+            truncated: inherited.truncated || context.steps > crate::eval::MAX_STEPS,
+            incomplete: inherited.incomplete
+                || self.recorded_lookup_incomplete
+                || !required_result_ready,
+            implicit_redefinitions: inherited.implicit_redefinitions.clone(),
+        }
+    }
+
+    /// Validate the specific generated-result recipe, not an arbitrary Feature
+    /// merely labeled implied. Publication provenance alone cannot override later
+    /// mutations of membership aliases, carriers, or the reference expression.
+    pub(super) fn checked_generated_result_bases(
+        &mut self,
+        element: usize,
+        steps: &mut usize,
+    ) -> Option<Vec<usize>> {
+        *steps = steps.saturating_add(1);
+        if *steps > crate::eval::MAX_STEPS {
+            return None;
+        }
+        let view = self.semantic_ownership.as_ref()?;
+        if !view.matches_suffix(self) || !view.contains(element) {
+            return None;
+        }
+        let anchor = view.source_anchor(element);
+        let result = view.result(anchor)?;
+        if result.feature != element
+            || self.elements.get(anchor)?.ty != "FeatureReferenceExpression"
+            || self.elements.get(element)?.ty != "Feature"
+            || self.elements[element].props.get("direction")?.as_str()? != "out"
+            || self.elements.get(result.membership)?.ty != "ReturnParameterMembership"
+        {
+            return None;
+        }
+        let raw = StoredStructure::for_query(self, steps)?;
+        if membership_evidence::member(self, &raw, anchor, result.membership, steps)? != element {
+            return None;
+        }
+        let referent = membership_evidence::first_unowned_member(
+            self,
+            &raw,
+            anchor,
+            "ParameterMembership",
+            "Feature",
+            None,
+            steps,
+        )?;
+        let relationships = semantic_ownership::owned_relationships(self, element)?;
+        *steps = steps.saturating_add(relationships.len());
+        if *steps > crate::eval::MAX_STEPS {
+            return None;
+        }
+        let relationships: Vec<_> = relationships.iter().collect();
+        let mut specialization = None;
+        let mut bases = Vec::new();
+        let mut seen = std::collections::HashSet::new();
+        for relationship in relationships {
+            if !seen.insert(relationship) {
+                return None;
+            }
+            let relation = self.elements.get(relationship)?;
+            if relation.ty == "TypeFeaturing" {
+                continue;
+            }
+            if !matches!(relation.ty, "Subsetting" | "Redefinition")
+                || !relation.props.get("isImplied")?.as_bool()?
+                || semantic_ownership::checked_relationship_carrier(
+                    self,
+                    &raw,
+                    relationship,
+                    steps,
+                )? != Some(element)
+            {
+                return None;
+            }
+            let redefinition = relation.ty == "Redefinition";
+            if redefinition && !self.result_redefinition_row_current(relationship) {
+                return None;
+            }
+            let target = type_relations::endpoint_with_carrier(
+                self,
+                element,
+                Some(element),
+                relationship,
+                &["specific", "subsettingFeature", "redefiningFeature"],
+                &["general", "subsettedFeature", "redefinedFeature"],
+                "Feature",
+                steps,
+            )?;
+            if !redefinition
+                && (specialization.replace(relationship).is_some() || target != referent)
+            {
+                return None;
+            }
+            bases.push(target);
+        }
+        specialization.map(|_| bases)
+    }
+}
