+    use serde_json::json;
+
+    fn graph() -> (ResolvedModel, usize, usize, usize) {
+        let mut model = Model::new();
+        model.add_source(
+            "result.kerml",
+            "classifier T { feature m; } feature n : T; feature x = n; feature other;",
+        );
+        assert!(!model.has_errors());
+        let mut r = ResolvedModel::build(&model);
+        let expression = r
+            .user_elements()
+            .find(|&e| r.element_type(e) == "FeatureReferenceExpression")
+            .unwrap()
+            .0;
+        let member = r.resolve_qualified("T::m").unwrap().0;
+        r.ensure_implied();
+        let result =
+            r.b.semantic_ownership
+                .as_ref()
+                .unwrap()
+                .result(expression)
+                .unwrap()
+                .feature;
+        (r, expression, result, member)
+    }
+
+    #[test]
+    fn result_inherits_through_its_referent_without_a_synthetic_scope() {
+        let (mut r, _, result, member) = graph();
+        assert!(!r.b.elem_scope.contains_key(&result));
+        let count = r.b.elements.len();
+        for _ in 0..2 {
+            assert!(
+                r.inherited_features(ElementRef(result), true)
+                    .contains(&ElementRef(member))
+            );
+            assert!(r.inheritance_incomplete(ElementRef(result), true));
+            assert!(r.inherited_features(ElementRef(result), false).is_empty());
+            assert_eq!(r.b.elements.len(), count);
+        }
+    }
+
+    #[test]
+    fn result_heritage_preserves_visibility_and_identity_based_redefinition() {
+        let mut model = Model::new();
+        model.add_source(
+            "heritage.kerml",
+            "classifier B { feature m; private feature hidden; } \
+             classifier D specializes B { feature replacement redefines B::m; } \
+             feature n : D; feature x = n;",
+        );
+        assert!(!model.has_errors());
+        let mut r = ResolvedModel::build(&model);
+        let expression = r
+            .user_elements()
+            .find(|&e| r.element_type(e) == "FeatureReferenceExpression")
+            .unwrap()
+            .0;
+        let original = r.resolve_qualified("B::m").unwrap();
+        let hidden = r.resolve_qualified("B::hidden").unwrap();
+        let replacement = r.resolve_qualified("D::replacement").unwrap();
+        r.ensure_implied();
+        let result =
+            r.b.semantic_ownership
+                .as_ref()
+                .unwrap()
+                .result(expression)
+                .unwrap()
+                .feature;
+        let features = r.inherited_features(ElementRef(result), true);
+        assert!(features.contains(&replacement));
+        assert!(!features.contains(&original));
+        assert!(!features.contains(&hidden));
+        assert!(r.inheritance_incomplete(ElementRef(result), true));
+    }
+
+    #[test]
+    fn changed_carriers_aliases_and_referents_do_not_reuse_generated_evidence() {
+        for change in 0..8 {
+            let (mut r, expression, result, _) = graph();
+            let reference = r.b.elements[expression].owned_relationships[0];
+            let membership = r.b.elements[result].owning_relationship.unwrap();
+            let subsetting = r.b.elements[result].owned_relationships[0];
+            let other = r.resolve_qualified("other").unwrap().0;
+            let other_id = r.b.elements[other].id;
+            assert!(r.b.checked_generated_result_bases(result, &mut 0).is_some());
+            match change {
+                0 => {
+                    r.b.elements[membership]
+                        .props
+                        .insert("memberElement", json!({"@id":other_id.to_string()}));
+                }
+                1 => {
+                    r.b.elements[result].owning_relationship = None;
+                }
+                2 => {
+                    r.b.elements[subsetting]
+                        .props
+                        .insert("general", json!({"@id":other_id.to_string()}));
+                }
+                3 => {
+                    r.b.elements[subsetting]
+                        .props
+                        .insert("target", json!([{"@id":other_id.to_string()}]));
+                }
+                4 => {
+                    r.b.elements[reference]
+                        .props
+                        .insert("memberElement", json!({"@id":other_id.to_string()}));
+                }
+                5 => {
+                    r.b.elements[result].id = other_id;
+                }
+                6 => {
+                    r.b.elements[result].owned_relationships.push(subsetting);
+                }
+                7 => {
+                    r.b.elements[subsetting]
+                        .props
+                        .insert("owningRelatedElement", json!({"@id":other_id.to_string()}));
+                }
+                _ => unreachable!(),
+            }
+            let projected = r.b.scope_less_inherited_memberships(result, true);
+            assert!(projected.incomplete, "change {change}");
+            assert!(projected.membership_order.is_empty(), "change {change}");
+        }
+    }
+
+    #[test]
+    fn exhausted_result_query_is_incomplete_and_a_fresh_query_can_retry() {
+        let (mut r, _, result, member) = graph();
+        let mut context = MembershipContext::default();
+        context.steps = crate::eval::MAX_STEPS;
+        let projected = r.b.generated_result_inheritance(result, true, &mut context);
+        assert!(projected.incomplete && projected.truncated);
+        assert!(projected.membership_order.is_empty());
+        assert!(
+            r.inherited_features(ElementRef(result), true)
+                .contains(&ElementRef(member))
+        );
+    }
+    const LIB: &str = "standard library package Base {classifier Anything;feature things:Anything;} standard library package Occurrences {class Occurrence specializes Base::Anything;feature occurrences:Occurrence subsets Base::things;} standard library package Performances {behavior Performance specializes Occurrences::Occurrence;function Evaluation specializes Performance {return result;}step performances:Performance subsets Occurrences::occurrences;expr evaluations:Evaluation subsets performances;}";
+    fn checked_fixture(
+        format: crate::model::GraphFormat,
+        source: &str,
+    ) -> (ResolvedModel, ElementRef, ElementRef) {
+        let mut model = Model::with_graph_format(format);
+        model.add_library_source("reference-library.kerml", LIB);
+        model.add_source("reference-user.kerml", source);
+        assert!(!model.has_errors());
+        let mut r = ResolvedModel::build(&model);
+        let expression = r
+            .user_elements()
+            .find(|&e| r.element_type(e) == "FeatureReferenceExpression")
+            .unwrap();
+        r.implied_relationships(expression);
+        let result = ElementRef(
+            r.b.semantic_ownership
+                .as_ref()
+                .unwrap()
+                .result(expression.0)
+                .unwrap()
+                .feature,
+        );
+        (r, expression, result)
+    }
+    #[test]
+    fn checked_result_features_use_the_shared_redefinition_and_visibility_reducer() {
+        use crate::{
+            json::{ClosurePolicy, TypeInputIssue},
+            model::GraphFormat,
+        };
+        for format in [GraphFormat::CanonicalV3, GraphFormat::LegacyV2] {
+            let (mut r, _, result) = checked_fixture(
+                format,
+                "classifier A {feature original;private feature hidden;} classifier B specializes A {feature replacement redefines A::original;} feature n:B;feature x=n;",
+            );
+            let replacement = r.resolve_qualified("B::replacement").unwrap();
+            let count = r.b.elements.len();
+            for _ in 0..2 {
+                let report = r.type_feature_report(result);
+                assert_eq!(report.projections.unwrap().features, [replacement]);
+                assert!(!r.b.elem_scope.contains_key(&result.0));
+                assert_eq!(r.b.elements.len(), count);
+            }
+            assert_eq!(
+                r.type_feature_report_with_budget(result, crate::eval::MAX_STEPS)
+                    .projections,
+                Err(TypeInputIssue::WorkLimit)
+            );
+            assert_eq!(
+                r.type_feature_report(result).projections.unwrap().features,
+                [replacement]
+            );
+            r.set_closure_policy(ClosurePolicy::Closure {
+                include_implied: true,
+            });
+            assert_eq!(
+                r.property(result, "feature"),
+                Ok(json!([{"@id":r.element_id(replacement)}]))
+            );
+        }
+    }
+    #[test]
+    fn complete_result_domains_are_revoked_by_mutation_or_missing_dependencies() {
+        use crate::model::GraphFormat;
+        for source in [
+            "feature n:Missing;feature x=n;",
+            "classifier A specializes B;classifier B specializes A;feature n:A;feature x=n;",
+        ] {
+            let (mut r, _, result) = checked_fixture(GraphFormat::CanonicalV3, source);
+            assert!(
+                r.type_feature_report(result).projections.is_err(),
+                "{source}"
+            );
+        }
+        let (mut r, _, result, _) = graph();
+        assert!(
+            r.type_feature_report(ElementRef(result))
+                .projections
+                .is_err()
+        );
+        for change in 0..8 {
+            let (mut r, expression, result) = checked_fixture(
+                GraphFormat::CanonicalV3,
+                "classifier T {feature m;} feature n:T;feature other;feature x=n;",
+            );
+            assert!(r.type_feature_report(result).projections.is_ok());
+            let other = r.resolve_qualified("other").unwrap();
+            let member = r.b.elements[result.0].owning_relationship.unwrap();
+            match change {
+                0 => r.b.set(result.0, "isEnd", json!(true)),
+                1 => r.b.set(result.0, "direction", json!("in")),
+                2 => r.b.elements[result.0].owning_relationship = None,
+                3 => r.b.set(
+                    member,
+                    "ownedMemberFeature",
+                    json!({"@id":r.element_id(other)}),
+                ),
+                4 => r.b.elements[result.0]
+                    .owned_relationships
+                    .make_mut()
+                    .clear(),
+                5 => r.b.metadata_association_generation = Some(std::sync::Arc::new(())),
+                6 => {
+                    let rel = r.b.elements[expression.0].owned_relationships[0];
+                    r.b.set(rel, "memberElement", json!({"@id":r.element_id(other)}));
+                }
+                7 => r.b.semantic_ownership = None,
+                _ => unreachable!(),
+            }
+            assert!(
+                r.type_feature_report(result).projections.is_err(),
+                "change {change}"
+            );
+        }
+    }
