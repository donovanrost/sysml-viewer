+    #[test]
+    fn malformed_return_evidence_revokes_argument_certificates_and_allows_retry() {
+        for mutation in 0..3 {
+            let mut r = fixture(
+                "mutation.kerml",
+                "function F {in x; return r;} feature a = F(1);",
+            );
+            let call = r
+                .user_elements()
+                .find(|&e| r.element_type(e) == "InvocationExpression")
+                .unwrap();
+            let membership = returns(&r, call)[0];
+            let result = r.b.elements[membership].children[0];
+            r.implied_relationships(call);
+            let expected = r.invocation_binding_report(call).arguments.unwrap();
+            let callee_id = r.element_id(expected.callee);
+            let call_id = r.element_id(call);
+            let before = r.b.elements.len();
+            assert_eq!(
+                r.invocation_binding_report_with_budget(call, crate::eval::MAX_STEPS)
+                    .arguments,
+                Err(super::super::InvocationBindingIssue::WorkLimit)
+            );
+            assert_eq!(r.b.elements.len(), before);
+            assert_eq!(
+                r.invocation_binding_report(call).arguments.unwrap(),
+                expected
+            );
+            match mutation {
+                0 => {
+                    r.b.elements[result].props.insert("direction", json!("in"));
+                }
+                1 => {
+                    r.b.elements[result].owning_relationship = None;
+                }
+                _ => {
+                    r.b.elements[membership]
+                        .props
+                        .insert("owningRelatedElement", json!({"@id":callee_id}));
+                }
+            }
+            assert!(
+                r.invocation_binding_report(call).arguments.is_err(),
+                "mutation {mutation}"
+            );
+            assert_eq!(r.b.elements.len(), before);
+            match mutation {
+                0 => {
+                    r.b.elements[result].props.insert("direction", json!("out"));
+                }
+                1 => {
+                    r.b.elements[result].owning_relationship = Some(membership);
+                }
+                _ => {
+                    r.b.elements[membership]
+                        .props
+                        .insert("owningRelatedElement", json!({"@id":call_id}));
+                }
+            }
+            r.discard_owned_result_tail();
+            r.implied_relationships(call);
+            assert_eq!(
+                r.invocation_binding_report(call).arguments.unwrap(),
+                expected
+            );
+        }
+    }
