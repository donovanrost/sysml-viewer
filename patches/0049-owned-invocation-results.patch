+    #[test]
+    fn grammar_returns_and_legacy_shapes_are_preserved() {
+        for source in [
+            "feature x = a as T;",
+            "feature x = a meta T;",
+            "feature x = all T;",
+            "feature x = new T();",
+        ] {
+            let r = model(GraphFormat::CanonicalV3, "cast.kerml", source);
+            let expression = r
+                .user_elements()
+                .find(|&e| conforms(r.element_type(e), "InstantiationExpression"))
+                .unwrap();
+            let memberships = returns(&r, expression);
+            assert_eq!(memberships.len(), 1, "{source}");
+            assert_eq!(
+                r.b.elements[memberships[0]]
+                    .props
+                    .get("isImplied")
+                    .and_then(|v| v.as_bool()),
+                Some(false),
+                "{source}"
+            );
+        }
+        for (file, source) in [
+            ("legacy.kerml", "feature x = Missing(1 + 2);"),
+            ("legacy.sysml", "action a accept after 1;"),
+        ] {
+            let r = model(GraphFormat::LegacyV2, file, source);
+            for expression in r
+                .user_elements()
+                .filter(|&e| conforms(r.element_type(e), "InvocationExpression"))
+            {
+                assert!(returns(&r, expression).is_empty());
+            }
+        }
+    }
