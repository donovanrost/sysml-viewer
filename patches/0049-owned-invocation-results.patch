+    #[test]
+    fn result_identities_and_relationships_replay_through_prepared_libraries() {
+        use crate::{libcache::LibraryCache, prepared::PreparedLibrary};
+        use std::sync::Arc;
+        let text = format!(
+            "{LIB} standard library package UserFunctions {{function F {{in x; return r;}} feature cached = F(1);}}"
+        );
+        let mut base = Model::with_graph_format(GraphFormat::CanonicalV3);
+        assert!(
+            base.add_library_source("result-library.kerml", &text)
+                .diagnostics
+                .is_empty()
+        );
+        base.record_library_cache();
+        ResolvedModel::build(&base);
+        let cache =
+            LibraryCache::from_bytes(&base.take_recorded_library_cache().unwrap().to_bytes())
+                .unwrap();
+        let prepared = base.prepare_library().unwrap();
+        let decoded =
+            Arc::new(PreparedLibrary::from_bytes(&prepared.to_bytes(149).unwrap(), 149).unwrap());
+        let mut expected = None;
+        for mode in 0..4 {
+            let mut m = Model::with_graph_format(GraphFormat::CanonicalV3);
+            match mode {
+                2 => Arc::clone(&prepared).install(&mut m).unwrap(),
+                3 => Arc::clone(&decoded).install(&mut m).unwrap(),
+                _ => {
+                    m.add_library_source("result-library.kerml", &text);
+                    if mode == 1 {
+                        m.set_library_cache(cache.clone());
+                    }
+                }
+            }
+            m.add_source(
+                "calls.kerml",
+                "feature a = UserFunctions::F(1); feature b = 1 + 2;",
+            );
+            let mut r = ResolvedModel::build(&m);
+            r.ensure_implied();
+            let calls: Vec<_> = r
+                .elements()
+                .filter(|&e| {
+                    matches!(
+                        r.element_type(e),
+                        "InvocationExpression" | "OperatorExpression"
+                    )
+                })
+                .collect();
+            let mut facts = Vec::new();
+            for call in calls {
+                let args = r.invocation_binding_report(call).arguments.unwrap();
+                let membership = returns(&r, call)[0];
+                let result = r.b.elements[membership].children[0];
+                let owned =
+                    super::super::semantic_ownership::owned_relationships(&r.b, result).unwrap();
+                let targets: Vec<_> = owned
+                    .iter()
+                    .filter_map(|i| {
+                        (r.b.elements[i].ty == "Redefinition").then(|| {
+                            r.b.elements[i]
+                                .props
+                                .get("redefinedFeature")
+                                .and_then(|v| v.as_reference())
+                                .unwrap()
+                        })
+                    })
+                    .collect();
+                assert!(!targets.is_empty());
+                facts.push((
+                    r.element_id(call),
+                    r.element_id(args.callee),
+                    r.b.elements[membership].id,
+                    r.b.elements[result].id,
+                    targets,
+                ));
+            }
+            assert_eq!(facts.len(), 3);
+            if let Some(expected) = &expected {
+                assert_eq!(&facts, expected, "mode {mode}");
+            } else {
+                expected = Some(facts);
+            }
+        }
+    }
