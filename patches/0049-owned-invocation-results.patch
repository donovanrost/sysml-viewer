+    #[test]
+    fn implied_results_survive_compact_lifting_without_becoming_arguments() {
+        for (file, source) in [
+            (
+                "expressions.kerml",
+                "function F {in x; in y; return r;} feature a = F(1,2); feature b = 1->F(2); feature c = (1 + 2) * 3; feature d = c as F; feature e = all F;",
+            ),
+            (
+                "triggers.sysml",
+                "action a accept after 1; action b accept at 2; action c accept when true;",
+            ),
+        ] {
+            let mut original = Model::with_graph_format(GraphFormat::CanonicalV3);
+            assert!(original.add_source(file, source).diagnostics.is_empty());
+            let before = crate::json::model_to_compact_json(&original);
+            let lifted = crate::lift::from_compact_json(&before).unwrap();
+            assert!(lifted.errors.is_empty(), "{:?}", lifted.errors);
+            let printed = sysmlv2_syntax::print::print_source(&lifted.unit);
+            let mut replay = Model::with_graph_format(GraphFormat::CanonicalV3);
+            assert!(
+                replay.add_source(file, &printed).diagnostics.is_empty(),
+                "{printed}"
+            );
+            assert_eq!(
+                crate::json::model_to_compact_json(&replay),
+                before,
+                "{printed}"
+            );
+        }
+    }
