+    #[test]
+    fn canonical_invocation_lowering_owns_results_without_callee_or_library_evidence() {
+        for (file, source, expected) in [
+            (
+                "call.kerml",
+                "feature x = Missing(1);",
+                "InvocationExpression",
+            ),
+            (
+                "arrow.kerml",
+                "feature x = 1->Missing(2);",
+                "InvocationExpression",
+            ),
+            ("operator.kerml", "feature x = 1 + 2;", "OperatorExpression"),
+            ("index.kerml", "feature x = a#(1);", "IndexExpression"),
+            (
+                "chain.kerml",
+                "feature x = a.b.c;",
+                "FeatureChainExpression",
+            ),
+            ("select.kerml", "feature x = a.?{true};", "SelectExpression"),
+            ("collect.kerml", "feature x = a.{1};", "CollectExpression"),
+            (
+                "after.sysml",
+                "action a accept after 1;",
+                "TriggerInvocationExpression",
+            ),
+            (
+                "at.sysml",
+                "action a accept at 1;",
+                "TriggerInvocationExpression",
+            ),
+            (
+                "when.sysml",
+                "action a accept when true;",
+                "TriggerInvocationExpression",
+            ),
+        ] {
+            let mut r = model(GraphFormat::CanonicalV3, file, source);
+            let expression = r
+                .user_elements()
+                .find(|&e| r.element_type(e) == expected)
+                .unwrap();
+            let memberships = returns(&r, expression);
+            assert_eq!(memberships.len(), 1, "{source}");
+            let membership = memberships[0];
+            assert_eq!(
+                r.b.elements[membership]
+                    .props
+                    .get("isImplied")
+                    .and_then(|v| v.as_bool()),
+                Some(true)
+            );
+            assert_eq!(
+                r.b.elements[membership]
+                    .props
+                    .get("owningRelatedElement")
+                    .and_then(|v| v.as_reference()),
+                Some(r.element_id(expression))
+            );
+            let children = &r.b.elements[membership].children;
+            assert_eq!(children.len(), 1);
+            let result = children[0];
+            assert_eq!(r.b.elements[result].ty, "Feature");
+            assert_eq!(r.b.elements[result].owning_relationship, Some(membership));
+            assert_eq!(
+                r.b.elements[result]
+                    .props
+                    .get("direction")
+                    .and_then(|v| v.as_str()),
+                Some("out")
+            );
+            assert!(r.b.elements[result].owned_relationships.is_empty());
+            assert!(!r.b.elem_scope.contains_key(&result));
+            assert!(r.b.implied.is_none());
+            let before = r.b.elements.len();
+            r.b.construct_invocation_result(expression.0);
+            assert_eq!(r.b.elements.len(), before, "{source}");
+        }
+    }
