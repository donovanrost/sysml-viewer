+//! Result ownership required by InstantiationExpression, constructed before
+//! specialization planning. Result redefinitions remain the responsibility of
+//! the shared positional planner; lowering neither selects nor copies a callee.
+
+use super::Builder;
+use crate::{metaclass::conforms, model::GraphFormat};
+use serde_json::json;
+
+impl Builder {
+    /// Finish a freshly lowered invocation, including operator subclasses and
+    /// SysML triggers. Casts and extent expressions already supply a typed return
+    /// through their grammar. Constructors have a separate result-owned argument
+    /// construction. Never create a second return or a synthetic textual scope.
+    pub(super) fn construct_invocation_result(&mut self, expression: usize) {
+        if self.graph_format != GraphFormat::CanonicalV3
+            || !conforms(self.elements[expression].ty, "InvocationExpression")
+            || self.elements[expression]
+                .owned_relationships
+                .iter()
+                .any(|&r| conforms(self.elements[r].ty, "ReturnParameterMembership"))
+        {
+            return;
+        }
+        let membership = self.new_relationship("ReturnParameterMembership", expression, "result");
+        self.set(membership, "isImplied", json!(true));
+        let result = self.new_owned_element("Feature", membership, "result");
+        self.set(result, "direction", json!("out"));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        json::{ElementRef, ResolvedModel},
+        model::Model,
+    };
+
+    fn model(format: GraphFormat, file: &str, source: &str) -> ResolvedModel {
+        let mut model = Model::with_graph_format(format);
+        let parsed = model.add_source(file, source);
+        assert!(
+            parsed.diagnostics.is_empty(),
+            "{source}: {:?}",
+            parsed.diagnostics
+        );
+        ResolvedModel::build(&model)
+    }
+
+    fn returns(r: &ResolvedModel, expression: ElementRef) -> Vec<usize> {
+        r.b.elements[expression.0]
+            .owned_relationships
+            .iter()
+            .copied()
+            .filter(|&m| conforms(r.b.elements[m].ty, "ReturnParameterMembership"))
+            .collect()
+    }
+
+    const LIB: &str = "standard library package Base {classifier Anything; feature things:Anything;}
+        standard library package Occurrences {class Occurrence specializes Base::Anything; feature occurrences:Occurrence subsets Base::things;}
+        standard library package Performances {behavior Performance specializes Occurrences::Occurrence; function Evaluation specializes Performance {return result;} step performances:Performance subsets Occurrences::occurrences; expr evaluations:Evaluation subsets performances;}
+        standard library package DataFunctions {function '+' {in x; in y; return sum;}}
+        standard library package Triggers {function TriggerAfter {in duration; in receiver; return result;} function TriggerAt {in instant; in receiver; return result;} function TriggerWhen {in condition; in receiver; return result;}}";
+
+    fn fixture(file: &str, source: &str) -> ResolvedModel {
+        let mut m = Model::with_graph_format(GraphFormat::CanonicalV3);
+        assert!(
+            m.add_library_source("result-library.kerml", LIB)
+                .diagnostics
+                .is_empty()
+        );
+        assert!(m.add_source(file, source).diagnostics.is_empty());
+        ResolvedModel::build(&m)
+    }
+
+    #[test]
+    fn full_library_invocations_keep_their_complete_argument_mappings() {
+        let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("../../spec-refs/SysML-v2-Release/sysml.library");
+        let mut m = Model::with_graph_format(GraphFormat::CanonicalV3);
+        assert_eq!(m.load_library_dir(&root).unwrap(), 94);
+        assert!(
+            m.add_source(
+                "calls.sysml",
+                "action a accept after 1 + 2; action b accept when 1 < 2;"
+            )
+            .diagnostics
+            .is_empty()
+        );
+        let mut r = ResolvedModel::build(&m);
+        let target = r.resolve_qualified("VectorFunctions::CartesianVectorOf::result::dimension");
+        assert!(
+            target.is_some(),
+            "unnamed library result must resolve before dynamic planning"
+        );
+        r.ensure_implied();
+        assert!(
+            r.b.effective_dynamic_plan().is_some(),
+            "{:?}",
+            r.b.dynamic_graph.as_ref().map(|g| &g.outcome)
+        );
+        let calls: Vec<_> = r
+            .user_elements()
+            .filter(|&e| {
+                matches!(
+                    r.element_type(e),
+                    "OperatorExpression" | "TriggerInvocationExpression"
+                )
+            })
+            .collect();
+        assert_eq!(calls.len(), 4);
+        for call in calls {
+            assert!(
+                r.invocation_binding_report(call).arguments.is_ok(),
+                "{}: {:?}",
+                r.element_type(call),
+                r.invocation_binding_report(call)
+            );
+        }
+    }
+
+    #[test]
+    fn shared_planner_redefines_callee_returns_without_changing_argument_order() {
+        for (file, source, kind, expected_args) in [
+            (
+                "function.kerml",
+                "function F {in a; in b; return r;} feature x = F(b=2,a=1);",
+                "InvocationExpression",
+                2,
+            ),
+            (
+                "operator.kerml",
+                "feature x = 1 + 2;",
+                "OperatorExpression",
+                2,
+            ),
+            (
+                "inherited.kerml",
+                "function Parent {in a; return r;} function F specializes Parent; feature x = F(a=1);",
+                "InvocationExpression",
+                1,
+            ),
+            (
+                "trigger.sysml",
+                "action x accept after 1;",
+                "TriggerInvocationExpression",
+                1,
+            ),
+            (
+                "trigger.sysml",
+                "action x accept at 1;",
+                "TriggerInvocationExpression",
+                1,
+            ),
+            (
+                "trigger.sysml",
+                "action x accept when true;",
+                "TriggerInvocationExpression",
+                1,
+            ),
+        ] {
+            let mut r = fixture(file, source);
+            let call = r
+                .user_elements()
+                .find(|&e| r.element_type(e) == kind)
+                .unwrap();
+            let result = r.b.elements[returns(&r, call)[0]].children[0];
+            let result_id = r.b.elements[result].id;
+            r.implied_relationships(call);
+            let args = r.invocation_binding_report(call).arguments.unwrap();
+            assert_eq!(args.bindings.len(), expected_args, "{source}");
+            assert!(args.bindings.iter().all(|arg| arg.parameter.0 != result));
+            let target = r
+                .function_result_report(args.callee)
+                .result
+                .unwrap()
+                .unwrap();
+            assert_ne!(result_id, r.element_id(target));
+            let owned =
+                super::super::semantic_ownership::owned_relationships(&r.b, result).unwrap();
+            assert!(
+                owned.iter().any(|edge| {
+                    r.b.elements[edge].ty == "Redefinition"
+                        && r.b.elements[edge]
+                            .props
+                            .get("redefiningFeature")
+                            .and_then(|v| v.as_reference())
+                            == Some(result_id)
+                        && r.b.elements[edge]
+                            .props
+                            .get("redefinedFeature")
+                            .and_then(|v| v.as_reference())
+                            == Some(r.element_id(target))
+                }),
+                "{source}: missing callee-result redefinition"
+            );
+            let count = r.b.elements.len();
+            r.implied_relationships(call);
+            assert_eq!(r.b.elements.len(), count);
+            assert_eq!(r.invocation_binding_report(call).arguments.unwrap(), args);
+        }
+    }
