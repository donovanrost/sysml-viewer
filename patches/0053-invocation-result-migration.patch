+/// Source order is retained even for a graph whose rows are not a preorder.
+/// The forest was checked by `index`; compute containment order and the last
+/// existing row of every subtree once rather than rescanning each invocation.
+fn ownership_subtrees(
+    rows: &[Value],
+    by: &HashMap<Uuid, usize>,
+    steps: &mut usize,
+) -> Result<(Vec<usize>, Vec<usize>), String> {
+    charge(steps, rows.len())?;
+    let mut children = vec![Vec::new(); rows.len()];
+    let mut pending = Vec::new();
+    for (i, row) in rows.iter().enumerate() {
+        for key in ["ownedRelationship", "ownedRelatedElement"] {
+            let edges = refs(row, key)?;
+            charge(steps, edges.len())?;
+            children[i].extend(edges.into_iter().map(|id| by[&id]));
+        }
+        if row["owningRelationship"].is_null() && row["owningRelatedElement"].is_null() {
+            pending.push((i, false));
+        }
+    }
+    let mut order = Vec::with_capacity(rows.len());
+    let mut ends: Vec<_> = (0..rows.len()).collect();
+    while let Some((node, exiting)) = pending.pop() {
+        charge(steps, 1)?;
+        if exiting {
+            for &child in &children[node] {
+                ends[node] = ends[node].max(ends[child]);
+            }
+        } else {
+            order.push(node);
+            pending.push((node, true));
+            pending.extend(children[node].iter().rev().map(|&i| (i, false)));
+        }
+    }
+    Ok((order, ends))
 }
 
