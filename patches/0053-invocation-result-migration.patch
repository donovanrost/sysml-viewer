+    #[test]
+    fn invocation_migration_matches_direct_lowering_for_nested_and_grammar_returns() {
+        for (file, source) in [
+            (
+                "call.kerml",
+                "function F {in x; return r;} feature x = F(F(1 + 2));",
+            ),
+            ("arrow.kerml", "feature x = 1->Missing(2);"),
+            ("index.kerml", "feature x = a#(1 + 2);"),
+            ("chain.kerml", "feature x = a.b.c;"),
+            ("select.kerml", "feature x = a.?{1 < 2};"),
+            ("collect.kerml", "feature x = a.{1 + 2};"),
+            ("cast.kerml", "class C; feature x = 1 as C;"),
+            ("extent.kerml", "class C; feature x = all C;"),
+            ("after.sysml", "action a accept after 1 + 2;"),
+            ("at.sysml", "action a accept at F();"),
+            ("when.sysml", "action a accept when 1 < 2;"),
+        ] {
+            let emit = |format| {
+                let mut model = Model::with_graph_format(format);
+                let parsed = model.add_source(file, source);
+                assert!(
+                    parsed.diagnostics.is_empty(),
+                    "{source}: {:?}",
+                    parsed.diagnostics
+                );
+                model_to_compact_json(&model)
+            };
+            let legacy = emit(GraphFormat::LegacyV2);
+            let canonical = emit(GraphFormat::CanonicalV3);
+            let migrated = migrate_conditional_graph(&legacy, &|_| None).unwrap();
+            assert_eq!(migrated.document, canonical, "{source}");
+            for (old, &index) in legacy
+                .as_array()
+                .unwrap()
+                .iter()
+                .zip(&migrated.element_indices)
+            {
+                assert_eq!(
+                    migrated.ids[&id(old).unwrap()],
+                    id(&canonical[index]).unwrap()
+                );
+            }
+            assert_eq!(
+                legacy.as_array().unwrap().len() + migrated.added.len(),
+                canonical.as_array().unwrap().len()
+            );
+            validate_graph_format(&canonical, GraphFormat::CanonicalV3).unwrap();
+        }
+    }
+
+    #[test]
+    fn compact_validation_only_admits_reconstructible_implied_return_pairs() {
+        let mut model = Model::with_graph_format(GraphFormat::CanonicalV3);
+        assert!(
+            model
