+                .diagnostics
+                .is_empty()
+        );
+        let original = model_to_compact_json(&model);
+        let rows = original.as_array().unwrap();
+        let by = index(rows, &mut 0).unwrap();
+        let membership = rows.iter().position(|r| r["isImplied"] == true).unwrap();
+        let result = by[&one(&rows[membership], "ownedRelatedElement").unwrap()];
+        let owner = by[&id(&rows[membership]["owningRelatedElement"]).unwrap()];
+        validate_graph_format(&original, GraphFormat::CanonicalV3).unwrap();
+        assert!(validate_graph_format(&original, GraphFormat::LegacyV2).is_err());
+        assert!(migrate_conditional_graph(&original, &|_| None).is_err());
+        for mutation in 0..7 {
+            let mut document = original.clone();
+            match mutation {
+                0 => document[result]["direction"] = json!("in"),
+                1 => document[result]["declaredName"] = json!("lost"),
+                2 => document[result]["isComposite"] = json!(true),
