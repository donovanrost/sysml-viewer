+fn lowered_structural_member(
+    rows: &[Value],
+    by: &HashMap<Uuid, usize>,
+    membership: usize,
+    steps: &mut usize,
+) -> Result<(), String> {
+    let row = &rows[membership];
+    if !matches!(
+        row["@type"].as_str(),
+        Some("ReturnParameterMembership" | "ParameterMembership")
+    ) {
+        return Err("migration requires authored compact rows".into());
+    }
+    let owner = by[&id(&row["owningRelatedElement"])?];
+    let result = by[&one(row, "ownedRelatedElement")?];
+    let feature = &rows[result];
+    let invocation = row["@type"] == "ReturnParameterMembership"
+        && crate::metaclass::conforms(
+            rows[owner]["@type"].as_str().unwrap(),
+            "InvocationExpression",
+        );
+    let receiver =
+        row["@type"] == "ParameterMembership" && rows[owner]["@type"] == "AcceptActionUsage";
+    let (kind, direction) = if invocation {
+        ("Feature", "out")
+    } else if receiver {
+        ("ReferenceUsage", "in")
+    } else {
+        return Err("migration requires reconstructible structural memberships".into());
+    };
+    if feature["@type"] != kind
+        || feature["direction"] != direction
+        || !refs(row, "ownedRelationship")?.is_empty()
+        || !refs(feature, "ownedRelationship")?.is_empty()
+    {
+        return Err("invalid lowered invocation result".into());
+    }
+    for (node, allowed) in [
+        (
+            row,
+            &["owningRelatedElement", "ownedRelatedElement"] as &[_],
+        ),
+        (feature, &["owningRelationship"] as &[_]),
+    ] {
+        charge(steps, node.as_object().unwrap().len())?;
+        for (key, value) in node.as_object().unwrap() {
+            if (value.is_object() || value.is_array())
+                && !allowed.contains(&key.as_str())
+                && !value.as_array().is_some_and(Vec::is_empty)
+            {
+                return Err("unrepresentable lowered invocation result property".into());
+            }
+        }
+    }
+    let mut authored_membership = row.clone();
+    authored_membership["isImplied"] = json!(false);
+    constructor_syntax_scalars(&authored_membership, None)?;
+    let mut scalars = feature.clone();
+    if receiver {
+        if scalars["isVariation"] != false {
+            return Err("invalid lowered accept receiver".into());
+        }
+        scalars.as_object_mut().unwrap().remove("isVariation");
+    }
+    constructor_syntax_scalars(&scalars, Some(direction))?;
+    let relationships = refs(&rows[owner], "ownedRelationship")?;
+    charge(steps, relationships.len())?;
+    if invocation
+        && relationships
+            .iter()
+            .filter(|r| {
+                crate::metaclass::conforms(
+                    rows[by[r]]["@type"].as_str().unwrap(),
+                    "ReturnParameterMembership",
+                )
+            })
+            .count()
+            != 1
+    {
+        return Err("lowered invocation result must be unique".into());
+    }
+    if receiver
+        && relationships
+            .iter()
+            .filter(|r| {
+                crate::metaclass::conforms(
+                    rows[by[r]]["@type"].as_str().unwrap(),
+                    "ParameterMembership",
+                )
+            })
+            .nth(1)
+            .copied()
+            != Some(id(row)?)
+    {
+        return Err("lowered accept receiver must be the second parameter".into());
+    }
+    Ok(())
+}
