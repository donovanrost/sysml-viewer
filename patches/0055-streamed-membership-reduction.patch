+                        .into_iter()
+                        .flatten()
+                        .any(|target| own_closure.contains(target))
+                })
+            })
+            .collect();
+        let mut features = node.owned.clone();
+        features.extend(surviving.iter().filter_map(|m| {
+            Facts
+                .is_feature_membership(m.relationship)
+                .then_some(m.member)
+        }));
+        (features, surviving)
+    }
