+                        &node,
+                        &exported,
+                        &graph,
+                        traversal,
+                        &Facts,
+                        &mut Some(&mut 0),
+                    )
+                    .unwrap();
+                assert_eq!(features, expected.0, "round {round}");
+                assert!(memberships == expected.1, "round {round}");
+            }
+        }
