+const DAMAGE_SOURCE: &str = "feature outer {member feature selected:ScalarValues::Integer;feature control:ScalarValues::Integer;}";
+fn damage(r: &mut ResolvedModel, f: ElementRef, d: Damage) {
+    let m = r.b.elements[f.0].owning_relationship.unwrap();
+    let o = r.resolve_qualified("outer").unwrap();
+    let control = r.resolve_qualified("outer::control").unwrap();
+    let wrong = r.element_id(control);
+    match d {
+        Damage::MissingOwner => r.b.elements[f.0].owning_relationship = None,
+        Damage::MissingChild => r.b.elements[m].children.make_mut().clear(),
+        Damage::ForeignCarrier => r.b.set(m, "owningRelatedElement", json!({"@id":wrong})),
+        Damage::WrongMember => r.b.set(m, "memberElement", json!({"@id":wrong})),
+        Damage::DuplicateCarrier => r.b.elements[control.0].owned_relationships.push(m),
+        Damage::Source => r.b.set(m, "source", json!([{"@id":wrong}])),
+        Damage::Target => r.b.set(m, "target", json!([{"@id":wrong}])),
+        Damage::OwnedArray => r.b.set(m, "ownedRelatedElement", json!([])),
+        Damage::Direction => r.b.set(f.0, "direction", json!("invalid")),
+        Damage::End => r.b.set(f.0, "isEnd", json!(true)),
+        Damage::Composite => r.b.set(f.0, "isComposite", json!(true)),
+        Damage::Variable => r.b.set(f.0, "isVariable", json!(true)),
+        Damage::Metadata => r.b.metadata_associations_incomplete = true,
+        Damage::NonNamespace => r.b.elements[o.0].ty = "Comment",
+        Damage::CrossFeature => r.b.set(o.0, "isEnd", json!(true)),
+    }
+}
