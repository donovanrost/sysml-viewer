+const DAMAGES: [Damage; 15] = [
+    Damage::MissingOwner,
+    Damage::MissingChild,
+    Damage::ForeignCarrier,
+    Damage::WrongMember,
+    Damage::DuplicateCarrier,
+    Damage::Source,
+    Damage::Target,
