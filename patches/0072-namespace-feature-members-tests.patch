+#[test]
+fn inherited_namespace_members_use_shared_redefinition_and_visibility() {
+    let mut r = fixture(
+        r#"
+      function Parent {
+        member feature original:ScalarValues::Integer;
+        member expr evaluation:Performances::LiteralIntegerEvaluation;
+        private member feature hidden:ScalarValues::String;
+        in x:ScalarValues::Integer default=1;
+        return result:ScalarValues::Integer;
+      }
+      function Child specializes Parent {
+        member feature replacement redefines Parent::original;
+        member expr current redefines Parent::evaluation;
+        member feature path chains current.result;
+      }
+      function Grandchild specializes Child;
+      function FeatureChild specializes Parent {feature replacement redefines Parent::original;}
+      feature call=Child();
+    "#,
+    );
+    ready(&mut r);
+    for name in ["Child::replacement", "Child::path"] {
+        exact(&mut r, name, "ScalarValues::Integer");
+    }
+    exact(
+        &mut r,
+        "Child::current",
+        "Performances::LiteralIntegerEvaluation",
+    );
+    let child = r.resolve_qualified("Child").unwrap();
+    let projection = r.type_feature_report(child).projections.unwrap();
+    let original = r.resolve_qualified("Parent::original").unwrap();
+    let replacement = r.resolve_qualified("Child::replacement").unwrap();
+    let hidden = r.resolve_qualified("Parent::hidden").unwrap();
+    let members = projection.members.unwrap();
+    assert!(members.contains(&replacement));
+    // removeRedefinedFeatures compares local ownedFeature targets, not all
+    // owned namespace members. Child keeps the original inherited member.
+    assert!(members.contains(&original));
+    assert!(!members.contains(&hidden));
+    assert!(!projection.features.contains(&replacement));
+    // On the next level both members are inherited; their redefinition closure
+    // suppresses the original. A local FeatureMembership suppresses it directly.
+    for name in ["Grandchild", "FeatureChild"] {
+        let descendant = r.resolve_qualified(name).unwrap();
+        let actual = r.type_feature_report(descendant).projections.unwrap();
+        assert!(!actual.members.unwrap().contains(&original), "{name}");
+    }
+    let call = r
+        .user_elements()
+        .find(|&e| r.element_type(e) == "InvocationExpression")
+        .unwrap();
+    default_identities(&mut r, call, "Parent::x");
+}
