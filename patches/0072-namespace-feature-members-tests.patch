+fn raw_library() -> Model {
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../spec-refs/SysML-v2-Release/sysml.library");
+    let mut model = Model::with_graph_format(GraphFormat::CanonicalV3);
+    assert_eq!(model.load_library_dir(&root).unwrap(), 94);
+    model
+}
+fn library() -> Arc<PreparedLibrary> {
+    static LIBRARY: OnceLock<Arc<PreparedLibrary>> = OnceLock::new();
+    Arc::clone(LIBRARY.get_or_init(|| raw_library().prepare_library().unwrap()))
+}
+fn resolve(mut model: Model, source: &str) -> ResolvedModel {
+    let parsed = model.add_source("namespace-feature-members.kerml", source);
+    assert!(parsed.diagnostics.is_empty(), "{:?}", parsed.diagnostics);
+    ResolvedModel::build(&model)
+}
+fn fixture(source: &str) -> ResolvedModel {
+    let mut model = Model::with_graph_format(GraphFormat::CanonicalV3);
+    library().install(&mut model).unwrap();
+    resolve(model, source)
+}
+fn ready(r: &mut ResolvedModel) {
+    r.ensure_implied();
+    r.set_closure_policy(ClosurePolicy::Closure {
+        include_implied: true,
+    });
+}
+fn exact(r: &mut ResolvedModel, name: &str, expected: &str) -> ElementRef {
+    let f = r.resolve_qualified(name).unwrap();
+    let t = r.resolve_qualified(expected).unwrap();
+    let rows = r.b.elements.len();
+    let report = r.feature_type_report(f);
+    assert_eq!(report.types, Ok(vec![t]), "{name}: {report:?}");
+    assert_eq!(
+        r.property(f, "type").unwrap(),
+        json!([{"@id":r.element_id(t)}])
+    );
+    assert_eq!(rows, r.b.elements.len());
+    f
+}
+fn default_identities(r: &mut ResolvedModel, call: ElementRef, first: &str) {
+    let report = r.invocation_default_report(call);
+    let defaults = report.selection.unwrap().defaults;
+    let expected = [
+        first,
+        "Performances::Performance::isDispatch",
+        "Performances::Performance::dispatchScope",
+        "Performances::Performance::thisPerformance",
+        "Occurrences::Occurrence::portionOfLife",
+        "Occurrences::Occurrence::this",
+        "Occurrences::Occurrence::localClock",
+        "Occurrences::Occurrence::isRunToCompletion",
+        "Occurrences::Occurrence::runToCompletionScope",
+        "Occurrences::Occurrence::incomingTransferSort",
+    ];
+    let actual: Vec<_> = defaults
+        .iter()
+        .map(|d| r.element_qualified_name(d.feature).unwrap())
+        .collect();
+    assert_eq!(actual, expected);
+    assert_eq!(
+        defaults[0].feature_with_value,
+        r.resolve_qualified(first).unwrap()
+    );
+}
