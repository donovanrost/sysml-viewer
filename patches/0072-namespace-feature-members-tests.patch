+        ready(&mut r);
+        let original = r.resolve_qualified("Root::original").unwrap();
+        let replacement = r.resolve_qualified("Child::replacement").unwrap();
+        for (owner, present, absent) in [
+            ("Child", vec![original, replacement], vec![]),
+            ("Grand", vec![replacement], vec![original]),
+            ("Local", vec![], vec![original]),
+            ("Aliased", vec![original], vec![]),
