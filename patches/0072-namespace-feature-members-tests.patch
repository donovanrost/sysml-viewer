+fn type_namespace_members_preserve_types_results_and_omitted_defaults() {
+    let mut r = fixture(SOURCE);
+    ready(&mut r);
+    let e = exact(&mut r, "F::e", "Performances::LiteralIntegerEvaluation");
+    for name in [
+        "F::typedSlot",
+        "F::valuePath",
+        "F::ordinaryPath",
+        "F::ordinarySlot",
+    ] {
+        exact(&mut r, name, "ScalarValues::Integer");
+    }
+    let result = r.expression_result_report(e).result.unwrap().unwrap();
+    let integer = r.resolve_qualified("ScalarValues::Integer").unwrap();
+    assert_eq!(r.feature_type_report(result).types, Ok(vec![integer]));
+    let f = r.resolve_qualified("F").unwrap();
+    let members = r.type_feature_report(f).projections.unwrap();
+    for name in ["F::e", "F::typedSlot", "F::valuePath"] {
+        let member = r.resolve_qualified(name).unwrap();
+        assert_eq!(r.property(member, "owningType"), Ok(json!(null)));
+        assert!(
+            members.members.as_ref().unwrap().contains(&member),
+            "{name}"
+        );
+        assert!(!members.features.contains(&member), "{name}");
+        assert!(!members.inputs.contains(&member), "{name}");
