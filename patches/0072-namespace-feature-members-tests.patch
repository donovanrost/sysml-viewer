+#[test]
+fn authored_binding_members_follow_shared_alias_and_redefinition_rules() {
+    let source = "class Root {feature left; feature right; member binding original of left=right;} class Child specializes Root {member binding replacement redefines Root::original of left=right;} class Grand specializes Child; class Local specializes Root {binding local redefines Root::original of left=right;} class Aliased {alias foreign for Root::original;}";
