+fn uncertified_generated_binding_members_cannot_borrow_authored_admission() {
+    for format in [GraphFormat::CanonicalV3, GraphFormat::LegacyV2] {
+        let mut r = binding_fixture("function Owner {in x; return z;}", format);
+        ready(&mut r);
+        let owner = r.resolve_qualified("Owner").unwrap();
+        let x = r.resolve_qualified("Owner::x").unwrap();
+        assert_eq!(r.type_input_report(owner).inputs, Ok(vec![x]));
+        let membership =
+            r.b.new_relationship("OwningMembership", owner.0, "uncertified-member");
+        let binding =
+            r.b.new_owned_element("BindingConnector", membership, "uncertified-binding");
+        assert!(binding >= r.b.explicit_len());
+        r.b.set(membership, "isImplied", json!(true));
+        r.b.set(binding, "isImplied", json!(true));
+        let report = r.type_input_report(owner);
+        assert!(report.inputs.is_err(), "{format:?}: {report:?}");
+        assert!(report.steps < crate::eval::MAX_STEPS);
+    }
