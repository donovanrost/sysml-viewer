+            let members = features.members.unwrap();
+            for member in present {
+                assert!(members.contains(&member));
+                assert!(!features.features.contains(&member));
+                assert!(!features.inputs.contains(&member));
+            }
+            for member in absent {
+                assert!(!members.contains(&member));
+            }
