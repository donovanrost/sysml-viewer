+fn fixture(format: GraphFormat, source: &str) -> ResolvedModel {
+    let mut m = Model::with_graph_format(format);
+    let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../spec-refs/SysML-v2-Release/sysml.library");
+    assert_eq!(m.load_library_dir(&root).unwrap(), 94);
+    let p = m.add_source("association-domains.kerml", source);
+    assert!(p.diagnostics.is_empty(), "{:?}", p.diagnostics);
+    ResolvedModel::build(&m)
+}
+fn names(r: &mut ResolvedModel, refs: &[ElementRef]) -> Vec<String> {
+    refs.iter()
+        .map(|&e| {
+            r.element_qualified_name(e)
+                .unwrap_or_else(|| r.element_id(e).to_string())
+        })
+        .collect()
+}
+#[test]
+fn association_library_end_identities_and_conditional_refusal() {
+    for format in [GraphFormat::CanonicalV3, GraphFormat::LegacyV2] {
+        let mut r = fixture(
+            format,
+            "abstract assoc Empty; assoc Pair specializes Links::BinaryLink {end feature left:Base::Anything; end feature right:Base::Anything;} assoc MissingBinary {end feature left:Base::Anything; end feature right:Base::Anything;} assoc struct ObjectPair specializes Objects::BinaryLinkObject {end feature left:Objects::Object; end feature right:Objects::Object;}",
+        );
+        for (name, expected) in [
+            ("Links::Link", vec![]),
+            (
+                "Links::BinaryLink",
+                vec!["Links::BinaryLink::source", "Links::BinaryLink::target"],
+            ),
+            (
+                "Links::SelfLink",
+                vec!["Links::SelfLink::thisThing", "Links::SelfLink::sameThing"],
+            ),
+            ("Links::links", vec![]),
+            (
+                "Links::binaryLinks",
+                vec!["Links::BinaryLink::source", "Links::BinaryLink::target"],
+            ),
+            (
+                "Links::selfLinks",
+                vec!["Links::selfLinks::thisThing", "Links::selfLinks::sameThing"],
+            ),
+            ("Objects::LinkObject", vec![]),
+            (
+                "Objects::BinaryLinkObject",
+                vec!["Links::BinaryLink::source", "Links::BinaryLink::target"],
+            ),
+            ("Empty", vec![]),
+            ("Pair", vec!["Pair::left", "Pair::right"]),
+            ("ObjectPair", vec!["ObjectPair::left", "ObjectPair::right"]),
+        ] {
+            exact_ends(&mut r, name, &expected);
+        }
+        let missing = r.resolve_qualified("MissingBinary").unwrap();
+        assert!(r.type_feature_report(missing).projections.is_err());
+        assert!(r.property(missing, "associationEnd").is_err());
+    }
+}
