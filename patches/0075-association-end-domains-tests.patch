+#[test]
+fn association_end_identities_replay_from_raw_prepared_and_serialized_full_libraries() {
+    use crate::prepared::PreparedLibrary;
+    use std::sync::Arc;
+
+    for format in [GraphFormat::LegacyV2, GraphFormat::CanonicalV3] {
+        let raw = || {
+            let mut model = Model::with_graph_format(format);
+            let root = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+                .join("../../spec-refs/SysML-v2-Release/sysml.library");
+            assert_eq!(model.load_library_dir(&root).unwrap(), 94);
+            model
+        };
+        let prepared = raw().prepare_library().unwrap();
+        let decoded =
+            Arc::new(PreparedLibrary::from_bytes(&prepared.to_bytes(145).unwrap(), 145).unwrap());
+        let mut expected = None;
+        for replay in [None, Some(prepared), Some(decoded)] {
+            let mut model = if let Some(replay) = replay {
+                let mut model = Model::with_graph_format(format);
+                replay.install(&mut model).unwrap();
+                model
+            } else {
+                raw()
+            };
+            assert!(model.add_source("association-replay.kerml", "abstract assoc Borrowed {alias selected for Links::SelfLink::thisThing;} assoc Dependent specializes Borrowed {end feature own:Base::Anything;}").diagnostics.is_empty());
+            let mut r = ResolvedModel::build(&model);
+            let mut identities = Vec::new();
+            for (name, ends) in [
+                ("Dependent", vec!["Dependent::own"]),
+                ("Borrowed", vec![]),
+                (
+                    "Links::SelfLink",
+                    vec!["Links::SelfLink::thisThing", "Links::SelfLink::sameThing"],
+                ),
+                (
+                    "Objects::BinaryLinkObject",
+                    vec!["Links::BinaryLink::source", "Links::BinaryLink::target"],
+                ),
+            ] {
+                exact_ends(&mut r, name, &ends);
+                let owner = r.resolve_qualified(name).unwrap();
+                let projection = r.type_feature_report(owner).projections.unwrap();
+                identities.push((
+                    r.element_id(owner).to_string(),
+                    projection
+                        .end_features
+                        .into_iter()
+                        .map(|e| r.element_id(e).to_string())
+                        .collect::<Vec<_>>(),
+                ));
+            }
+            if let Some(expected) = &expected {
+                assert_eq!(&identities, expected, "{format:?}");
+            } else {
+                expected = Some(identities);
+            }
+        }
+    }
+}
+#[test]
+fn association_conditional_bases_cannot_be_hidden_by_descendants_or_selection() {
+    for format in [GraphFormat::LegacyV2, GraphFormat::CanonicalV3] {
+        let mut r = small(
+            format,
+            r#"
+   assoc MissingBinary {end feature left:Base::Anything; end feature right:Base::Anything;}
+   assoc Child specializes MissingBinary {end feature e1:Base::Anything; end feature e2:Base::Anything; end feature e3:Base::Anything;}
+   assoc struct MissingObject;
+   assoc struct MissingObjectBinary specializes Objects::LinkObject {end feature left:Objects::Object; end feature right:Objects::Object;}
+   classifier Other;
+  "#,
+        );
+        let other = r.resolve_qualified("Other").unwrap();
+        for name in [
+            "MissingBinary",
+            "Child",
+            "MissingObject",
+            "MissingObjectBinary",
+        ] {
+            let e = r.resolve_qualified(name).unwrap();
+            assert!(
+                r.type_feature_report(e).projections.is_err(),
+                "{format:?} {name}"
+            );
+            assert_eq!(
+                super::TypeRelations::default().specializes(&mut r.b, e.0, other.0, &mut 0),
+                super::RelationFact::Unknown,
+                "{name}"
+            );
+        }
+        let child = r.resolve_qualified("Child").unwrap();
+        let parent = r.resolve_qualified("MissingBinary").unwrap();
+        for exclude_implied in [false, true] {
+            assert!(
+                r.b.checked_type_membership_operation(
+                    child.0,
+                    &[],
+                    &[parent.0],
+                    exclude_implied,
+                    &mut 0
+                )
+                .is_err()
+            );
+        }
+    }
+}
