+   abstract assoc Empty;
+   assoc One {end feature left:Base::Anything;}
+   assoc Pair specializes Links::BinaryLink {end feature left:Base::Anything; end feature right:Base::Anything;}
+   assoc Inherited specializes Pair;
+   assoc Replaced specializes Pair {end feature e1:Base::Anything; end feature e2:Base::Anything;}
+   assoc Three {end feature e1:Base::Anything; end feature e2:Base::Anything; end feature e3:Base::Anything;}
+   assoc ThreeWithBinary specializes Links::BinaryLink {end feature e1:Base::Anything; end feature e2:Base::Anything; end feature e3:Base::Anything;}
+   abstract assoc Aliased {alias referencedEnd for Pair::left;}
+   assoc struct ObjectPair specializes Objects::BinaryLinkObject {end feature left:Objects::Object; end feature right:Objects::Object;}
+  "#,
+        );
+        for (name, expected) in [
+            ("Empty", vec![]),
