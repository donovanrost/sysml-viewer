+#[test]
+fn association_alias_dependencies_refuse_damage_cycles_and_budget_exhaustion() {
+    for format in [GraphFormat::LegacyV2, GraphFormat::CanonicalV3] {
+        for warm in [false, true] {
+            for damage in 0..4 {
+                let mut r = small(
+                    format,
+                    "assoc Pair specializes Links::BinaryLink {end feature left:Base::Anything; end feature right:Base::Anything;} classifier Other; subclassifier Pair specializes Other; abstract assoc Holder {alias selected for Pair::left;}",
+                );
+                let holder = r.resolve_qualified("Holder").unwrap();
+                let pair = r.resolve_qualified("Pair").unwrap();
+                let left = r.resolve_qualified("Pair::left").unwrap();
+                let right = r.resolve_qualified("Pair::right").unwrap();
+                let membership = r.b.elements[left.0].owning_relationship.unwrap();
+                if warm {
+                    exact_ends(&mut r, "Holder", &[]);
+                }
+                match damage {
+                    0 => r.b.set(left.0, "isEnd", serde_json::json!("true")),
+                    1 => {
+                        let id = r.element_id(right);
+                        r.b.set(membership, "memberElement", serde_json::json!({"@id":id}));
+                    }
+                    2 => r.b.elements[pair.0].ty = "AssociationStructure",
+                    3 => r.b.elements[left.0].owning_relationship = None,
+                    _ => unreachable!(),
+                }
+                let report = r.type_feature_report(holder);
+                assert!(
+                    report.projections.is_err(),
+                    "{format:?} warm={warm} damage={damage}"
+                );
+                assert!(report.steps < crate::eval::MAX_STEPS, "{report:?}");
+            }
+        }
+        for source in [
+            "assoc Pair specializes Missing {end feature left:Base::Anything;} abstract assoc Holder {alias selected for Pair::left;}",
+            "assoc Pair specializes Other {end feature left:Base::Anything;} assoc Other specializes Pair; abstract assoc Holder {alias selected for Pair::left;}",
+        ] {
+            let mut r = small(format, source);
+            let holder = r.resolve_qualified("Holder").unwrap();
+            assert!(r.type_feature_report(holder).projections.is_err());
+        }
+        let mut r = small(
+            format,
+            "assoc Pair specializes Links::BinaryLink {end feature left:Base::Anything; end feature right:Base::Anything;} classifier Other; subclassifier Pair specializes Other; abstract assoc Holder {alias selected for Pair::left;}",
+        );
+        let holder = r.resolve_qualified("Holder").unwrap();
+        assert_eq!(
+            r.type_feature_report_with_budget(holder, crate::eval::MAX_STEPS)
+                .projections,
+            Err(crate::json::TypeInputIssue::WorkLimit)
+        );
+        exact_ends(&mut r, "Holder", &[]);
+    }
+}
