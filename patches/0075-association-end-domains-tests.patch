+const LIB: &str = r#"
+standard library package Base { classifier Anything; feature things:Anything; }
+standard library package Occurrences { class Occurrence specializes Base::Anything; }
+standard library package Links {
+ abstract assoc Link specializes Base::Anything;
+ assoc BinaryLink specializes Link {
+  end feature source:Base::Anything;
+  end feature target:Base::Anything;
+ }
+}
+standard library package Objects {
+ struct Object specializes Occurrences::Occurrence;
+ abstract assoc struct LinkObject specializes Links::Link,Object;
+ assoc struct BinaryLinkObject specializes Links::BinaryLink,LinkObject;
+}
+"#;
+fn small(format: GraphFormat, source: &str) -> ResolvedModel {
+    let mut m = Model::with_graph_format(format);
+    assert!(
+        m.add_library_source("association-library.kerml", LIB)
+            .diagnostics
+            .is_empty()
+    );
+    let parsed = m.add_source("association-acceptance.kerml", source);
+    assert!(parsed.diagnostics.is_empty(), "{:?}", parsed.diagnostics);
+    ResolvedModel::build(&m)
+}
+fn exact_ends(r: &mut ResolvedModel, name: &str, expected: &[&str]) {
+    let owner = r.resolve_qualified(name).unwrap();
+    let report = r.type_feature_report(owner);
+    let p = report
+        .projections
+        .unwrap_or_else(|e| panic!("{name}: {e:?} steps={}", report.steps));
+    assert_eq!(names(r, &p.end_features), expected, "{name}");
+    assert!(report.steps < crate::eval::MAX_STEPS);
+    r.set_closure_policy(crate::json::ClosurePolicy::Closure {
+        include_implied: true,
+    });
+    let expected = serde_json::Value::Array(
+        p.end_features
+            .iter()
+            .map(|&end| serde_json::json!({"@id":r.element_id(end)}))
+            .collect(),
+    );
+    let properties = if r.is_kind(owner, "Association") {
+        vec!["endFeature", "associationEnd"]
+    } else {
+        vec!["endFeature"]
+    };
+    for property in properties {
+        assert_eq!(
+            r.property(owner, property),
+            Ok(expected.clone()),
+            "{name}: {property}"
+        );
+    }
+}
