+#[test]
+fn association_specialization_proof_and_budget_retry_do_not_leak_partial_facts() {
+    for format in [GraphFormat::LegacyV2, GraphFormat::CanonicalV3] {
+        let mut r = small(
+            format,
+            "assoc Pair specializes Links::BinaryLink {end feature left:Base::Anything; end feature right:Base::Anything;} classifier Other;",
+        );
+        let owner = r.resolve_qualified("Pair").unwrap();
+        let other = r.resolve_qualified("Other").unwrap();
+        assert_eq!(
+            r.type_feature_report_with_budget(owner, crate::eval::MAX_STEPS)
+                .projections,
+            Err(crate::json::TypeInputIssue::WorkLimit)
+        );
+        exact_ends(&mut r, "Pair", &["Pair::left", "Pair::right"]);
+        let mut relations = super::TypeRelations::default();
+        assert_eq!(
+            relations.specializes(&mut r.b, owner.0, other.0, &mut 0),
+            super::RelationFact::No
+        );
+        let binary = r.resolve_qualified("Links::BinaryLink").unwrap();
+        r.b.set(binary.0, "declaredName", serde_json::json!("Renamed"));
+        assert_eq!(
+            relations.specializes(&mut r.b, owner.0, other.0, &mut 0),
+            super::RelationFact::Unknown
+        );
+        assert_eq!(
+            super::TypeRelations::default().specializes(&mut r.b, owner.0, other.0, &mut 0),
+            super::RelationFact::Unknown
+        );
+        r.b.set(binary.0, "declaredName", serde_json::json!("BinaryLink"));
+        exact_ends(&mut r, "Pair", &["Pair::left", "Pair::right"]);
+        assert_eq!(
+            super::TypeRelations::default().specializes(&mut r.b, owner.0, other.0, &mut 0),
+            super::RelationFact::No
+        );
+    }
+}
