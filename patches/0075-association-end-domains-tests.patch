+fn association_domains_recheck_damaged_memberships_roles_and_metaclasses() {
+    for format in [GraphFormat::LegacyV2, GraphFormat::CanonicalV3] {
+        for warm in [false, true] {
+            for damage in 0..6 {
+                let mut r = small(
+                    format,
+                    "assoc Pair specializes Links::BinaryLink {end feature left:Base::Anything; end feature right:Base::Anything;}",
+                );
+                let owner = r.resolve_qualified("Pair").unwrap();
+                let left = r.resolve_qualified("Pair::left").unwrap();
+                let right = r.resolve_qualified("Pair::right").unwrap();
+                let membership = r.b.elements[left.0].owning_relationship.unwrap();
+                if warm {
+                    exact_ends(&mut r, "Pair", &["Pair::left", "Pair::right"]);
+                }
+                match damage {
+                    0 => r.b.set(left.0, "isEnd", serde_json::json!("true")),
+                    1 => {
+                        let id = r.element_id(right);
+                        r.b.set(membership, "memberElement", serde_json::json!({"@id":id}));
+                    }
+                    2 => r.b.elements[left.0].owning_relationship = None,
+                    3 => r.b.elements[owner.0].ty = "AssociationStructure",
