+#[test]
+fn standalone_subclassification_is_audited_without_adding_owned_ancestry() {
+    for format in [GraphFormat::LegacyV2, GraphFormat::CanonicalV3] {
+        for warm in [false, true] {
+            for damage in 0..7 {
+                let mut r = small(
+                    format,
+                    "assoc Pair specializes Links::BinaryLink {end feature left:Base::Anything; end feature right:Base::Anything;} classifier Foreign {feature external;} subclassifier Pair specializes Foreign;",
+                );
+                let pair = r.resolve_qualified("Pair").unwrap();
+                let foreign = r.resolve_qualified("Foreign").unwrap();
+                let left = r.resolve_qualified("Pair::left").unwrap();
+                let mut relation_reader = super::TypeRelations::default();
+                relation_reader.evidence.index(&mut r.b, &mut 0).unwrap();
+                let relationship = relation_reader.evidence.structure.nonowned_bases[&pair.0][0];
+                if warm {
+                    exact_ends(&mut r, "Pair", &["Pair::left", "Pair::right"]);
+                }
+                match damage {
+                    0 => {}
+                    1 => {
+                        let id = r.element_id(left);
+                        r.b.set(
+                            relationship,
+                            "superclassifier",
+                            serde_json::json!({"@id":id}),
+                        );
+                    }
+                    2 => {
+                        let id = r.element_id(foreign);
+                        r.b.set(relationship, "specific", serde_json::json!({"@id":id}));
+                    }
+                    3 => {
+                        let id = r.element_id(pair);
+                        r.b.set(
+                            relationship,
+                            "owningRelatedElement",
+                            serde_json::json!({"@id":id}),
+                        );
+                    }
+                    4 => r.b.set(
+                        relationship,
+                        "superclassifier",
+                        serde_json::json!({"@id":uuid::Uuid::new_v4()}),
+                    ),
+                    5 => {
+                        let id = r.element_id(foreign);
+                        r.b.set(relationship, "source", serde_json::json!([{"@id":id}]));
+                    }
+                    6 => {
+                        let id = r.element_id(foreign);
+                        r.b.set(
+                            relationship,
+                            "relatedElement",
+                            serde_json::json!([{"@id":id},{"@id":id}]),
+                        );
+                    }
+                    _ => unreachable!(),
+                }
+                let report = r.type_feature_report(pair);
+                if damage == 0 {
+                    let p = report.projections.unwrap();
+                    let external = r.resolve_qualified("Foreign::external").unwrap();
+                    assert!(!p.features.contains(&external));
+                    assert_eq!(
+                        super::TypeRelations::default()
+                            .specializes(&mut r.b, pair.0, foreign.0, &mut 0),
+                        super::RelationFact::No
+                    );
+                    exact_ends(&mut r, "Pair", &["Pair::left", "Pair::right"]);
+                } else {
+                    assert!(
+                        report.projections.is_err(),
+                        "{format:?} warm={warm} damage={damage}: {report:?}"
+                    );
+                    if matches!(damage, 2 | 5 | 6) {
+                        assert!(
+                            r.type_feature_report(foreign).projections.is_err(),
+                            "every conflicting source claim must remain qualified"
+                        );
+                    }
+                }
+            }
+        }
+    }
+}
