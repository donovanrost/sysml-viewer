+#[test]
+fn association_alias_prerequisites_preserve_foreign_suppression_and_local_slots() {
+    for format in [GraphFormat::LegacyV2, GraphFormat::CanonicalV3] {
+        for reversed in [false, true] {
+            for (selected, remaining) in [("left", "q"), ("right", "p")] {
+                let parent = "assoc Parent specializes Links::BinaryLink {end feature p:Base::Anything; end feature q:Base::Anything;}";
+                let foreign = "assoc Foreign specializes Parent {end feature left:Base::Anything; end feature right:Base::Anything; feature foreignOnly;}";
+                let consumers = format!(
+                    "abstract assoc Aliases {{alias selected for Foreign::{selected};}} assoc Merged specializes Parent,Aliases; assoc Consumer specializes Merged {{end feature local:Base::Anything;}}"
+                );
+                let source = if reversed {
+                    format!("{consumers} {foreign} {parent}")
+                } else {
+                    format!("{parent} {foreign} {consumers}")
+                };
+                let mut r = small(format, &source);
+                for _ in 0..2 {
+                    exact_ends(&mut r, "Merged", &[&format!("Parent::{remaining}")]);
+                    exact_ends(&mut r, "Consumer", &["Consumer::local"]);
+                    exact_ends(&mut r, "Aliases", &[]);
+                    let consumer = r.resolve_qualified("Consumer").unwrap();
+                    let foreign = r.resolve_qualified("Foreign").unwrap();
+                    let borrowed = r
+                        .resolve_qualified(&format!("Foreign::{selected}"))
+                        .unwrap();
+                    let unrelated = r.resolve_qualified("Foreign::foreignOnly").unwrap();
+                    let projection = r.type_feature_report(consumer).projections.unwrap();
+                    assert!(!projection.features.contains(&borrowed));
+                    assert!(!projection.features.contains(&unrelated));
+                    let members = projection.members.unwrap();
+                    assert!(members.contains(&borrowed));
+                    assert!(!members.contains(&unrelated));
+                    assert_eq!(
+                        super::TypeRelations::default()
+                            .specializes(&mut r.b, consumer.0, foreign.0, &mut 0),
+                        super::RelationFact::No,
+                        "a proof prerequisite is not an ancestor"
+                    );
+                    let local = r.resolve_qualified("Consumer::local").unwrap();
+                    let target = r
+                        .resolve_qualified(&format!("Parent::{remaining}"))
+                        .unwrap();
+                    assert_eq!(
+                        r.b.effective_positional_redefinitions()
+                            .unwrap()
+                            .targets
+                            .get(&local.0),
+                        Some(&vec![target.0]),
+                        "{format:?} reversed={reversed} selected={selected}"
+                    );
+                }
+            }
+        }
+    }
+}
