package RequirementPositive {
    requirement def T;
    requirement value : T;
}

package ConcernPositive {
    concern def T;
    concern value : T;
}

package CasePositive {
    case def T;
    case value : T;
}

package AnalysisCasePositive {
    analysis def T;
    analysis value : T;
}

package VerificationCasePositive {
    verification def T;
    verification value : T;
}

package UseCasePositive {
    use case def T;
    use case value : T;
}
