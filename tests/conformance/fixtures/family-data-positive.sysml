package AttributePositive {
    attribute def T;
    attribute value : T;
}

package EnumerationPositive {
    enum def T;
    enum value : T;
}

package OccurrencePositive {
    occurrence def T;
    occurrence value : T;
}

package ItemPositive {
    item def T;
    item value : T;
}

package PartPositive {
    part def T;
    part value : T;
}

package PortPositive {
    port def T;
    port value : T;
}
