package OrderedComparisons {
    attribute predicate = 2 < 3;
    alias flag for predicate;
    attribute ltLessCount = if 2 < 3 ? 7 else 9;
    part ltLess [ltLessCount];
    attribute ltEqualCount = if 3 < 3 ? 7 else 9;
    part ltEqual [ltEqualCount];
    attribute ltGreaterCount = if 4 < 3 ? 7 else 9;
    part ltGreater [ltGreaterCount];
    attribute leLessCount = if 2 <= 3 ? 7 else 9;
    part leLess [leLessCount];
    attribute leEqualCount = if 3 <= 3 ? 7 else 9;
    part leEqual [leEqualCount];
    attribute leGreaterCount = if 4 <= 3 ? 7 else 9;
    part leGreater [leGreaterCount];
    attribute gtLessCount = if 2 > 3 ? 7 else 9;
    part gtLess [gtLessCount];
    attribute gtEqualCount = if 3 > 3 ? 7 else 9;
    part gtEqual [gtEqualCount];
    attribute gtGreaterCount = if 4 > 3 ? 7 else 9;
    part gtGreater [gtGreaterCount];
    attribute geLessCount = if 2 >= 3 ? 7 else 9;
    part geLess [geLessCount];
    attribute geEqualCount = if 3 >= 3 ? 7 else 9;
    part geEqual [geEqualCount];
    attribute geGreaterCount = if 4 >= 3 ? 7 else 9;
    part geGreater [geGreaterCount];
    attribute largeCount = if 9007199254740992 < 9007199254740993 ? 11 else 0;
    part large [largeCount];
    attribute largeReverseCount = if 9007199254740993 <= 9007199254740992 ? 0 else 12;
    part largeReverse [largeReverseCount];
    attribute limitCount = if 170141183460469231731687303715884105726 < 170141183460469231731687303715884105727 ? 13 else 0;
    part limit [limitCount];
    attribute negativeCount = if -9007199254740993 < -9007199254740992 ? 14 else 0;
    part negative [negativeCount];
    attribute rationalCount = if 1 / 3 < 1 / 2 ? 15 else 0;
    part rational [rationalCount];
    attribute rationalEqualCount = if 2 / 6 <= 1 / 3 ? 16 else 0;
    part rationalEqual [rationalEqualCount];
    attribute rationalMixedCount = if 7 / 2 > 3 ? 17 else 0;
    part rationalMixed [rationalMixedCount];
    attribute rationalCloseCount = if 9007199254740992 / 9007199254740993 < 1 ? 18 else 0;
    part rationalClose [rationalCloseCount];
    attribute arithmeticCount = if 2 + 3 * 4 >= 14 ? 19 else 0;
    part arithmetic [arithmeticCount];
    attribute viaAliasCount = if flag ? 20 else 0;
    part viaAlias [viaAliasCount];
    attribute nestedCount = if 2 < 3 ? (if 4 >= 5 ? 0 else 21) else 0;
    part nested [nestedCount];
    attribute lazyCount = if 2 > 3 ? 1 / 0 else 22;
    part lazy [lazyCount];
    attribute wideArithmeticCount = if 170141183460469231731687303715884105727 + 1 > 170141183460469231731687303715884105727 ? 23 else 0;
    part wideArithmetic [wideArithmeticCount];
}
