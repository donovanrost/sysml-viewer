    attribute wideExactCount = if (170141183460469231731687303715884105727 + 1 === 2 ^ 127) ? 7 else 9;
    part wideExact [wideExactCount];
    attribute closeRationalCount = if (9007199254740992 / 9007199254740993 == 1) ? 7 else 9;
    part closeRational [closeRationalCount];
