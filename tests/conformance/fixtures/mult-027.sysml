package LogicalPredicates {
    attribute missing : ScalarValues::Boolean;
    attribute predicate = not false;
    alias flag for predicate;
    attribute negateTrueCount = if (not true) ? 7 else 9;
    part negateTrue [negateTrueCount];
    attribute negateFalseCount = if (not false) ? 7 else 9;
    part negateFalse [negateFalseCount];
    attribute conjunction00Count = if (false & false) ? 7 else 9;
    part conjunction00 [conjunction00Count];
    attribute conjunction01Count = if (false & true) ? 7 else 9;
    part conjunction01 [conjunction01Count];
    attribute conjunction10Count = if (true & false) ? 7 else 9;
    part conjunction10 [conjunction10Count];
    attribute conjunction11Count = if (true & true) ? 7 else 9;
    part conjunction11 [conjunction11Count];
    attribute disjunction00Count = if (false | false) ? 7 else 9;
    part disjunction00 [disjunction00Count];
    attribute disjunction01Count = if (false | true) ? 7 else 9;
    part disjunction01 [disjunction01Count];
    attribute disjunction10Count = if (true | false) ? 7 else 9;
    part disjunction10 [disjunction10Count];
    attribute disjunction11Count = if (true | true) ? 7 else 9;
    part disjunction11 [disjunction11Count];
    attribute exclusive00Count = if (false xor false) ? 7 else 9;
    part exclusive00 [exclusive00Count];
    attribute exclusive01Count = if (false xor true) ? 7 else 9;
    part exclusive01 [exclusive01Count];
    attribute exclusive10Count = if (true xor false) ? 7 else 9;
    part exclusive10 [exclusive10Count];
    attribute exclusive11Count = if (true xor true) ? 7 else 9;
    part exclusive11 [exclusive11Count];
    attribute and00Count = if (false and false) ? 7 else 9;
    part and00 [and00Count];
    attribute and01Count = if (false and true) ? 7 else 9;
    part and01 [and01Count];
    attribute and10Count = if (true and false) ? 7 else 9;
    part and10 [and10Count];
    attribute and11Count = if (true and true) ? 7 else 9;
    part and11 [and11Count];
    attribute or00Count = if (false or false) ? 7 else 9;
    part or00 [or00Count];
    attribute or01Count = if (false or true) ? 7 else 9;
    part or01 [or01Count];
    attribute or10Count = if (true or false) ? 7 else 9;
    part or10 [or10Count];
    attribute or11Count = if (true or true) ? 7 else 9;
    part or11 [or11Count];
    attribute implies00Count = if (false implies false) ? 7 else 9;
    part implies00 [implies00Count];
    attribute implies01Count = if (false implies true) ? 7 else 9;
    part implies01 [implies01Count];
    attribute implies10Count = if (true implies false) ? 7 else 9;
    part implies10 [implies10Count];
    attribute implies11Count = if (true implies true) ? 7 else 9;
    part implies11 [implies11Count];
    attribute skipAndCount = if (false and missing) ? 7 else 9;
    part skipAnd [skipAndCount];
    attribute skipOrCount = if (true or missing) ? 7 else 9;
    part skipOr [skipOrCount];
    attribute skipImpliesCount = if (false implies missing) ? 7 else 9;
    part skipImplies [skipImpliesCount];
    attribute skipAndDivisionCount = if (false and (1 / 0 == 2)) ? 7 else 9;
    part skipAndDivision [skipAndDivisionCount];
    attribute skipOrDivisionCount = if (true or (1 / 0 == 2)) ? 7 else 9;
    part skipOrDivision [skipOrDivisionCount];
    attribute skipImpliesDivisionCount = if (false implies (1 / 0 == 2)) ? 7 else 9;
    part skipImpliesDivision [skipImpliesDivisionCount];
    attribute nestedCount = if (not (true and false)) ? 7 else 9;
    part nested [nestedCount];
    attribute combinedCount = if ((1 < 2) and (3 == 3)) ? 7 else 9;
    part combined [combinedCount];
    attribute viaAliasCount = if (flag or false) ? 7 else 9;
    part viaAlias [viaAliasCount];
}
