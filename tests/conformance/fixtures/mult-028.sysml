package PredicateGuards {
    attribute missing : ScalarValues::Boolean;
    attribute cycleA = not cycleB;
    attribute cycleB = not cycleA;
    attribute mixedEqualityCount = if (true == 1) ? 7 else 9;
    part mixedEquality [mixedEqualityCount];
    attribute mixedInequalityCount = if (false != 0) ? 7 else 9;
    part mixedInequality [mixedInequalityCount];
    attribute mixedSameCount = if (1 === true) ? 7 else 9;
    part mixedSame [mixedSameCount];
    attribute mixedNotSameCount = if (0 !== false) ? 7 else 9;
    part mixedNotSame [mixedNotSameCount];
    attribute realEqualityCount = if (1.0 == 1) ? 7 else 9;
    part realEquality [realEqualityCount];
    attribute infinityEqualityCount = if (* == *) ? 7 else 9;
    part infinityEquality [infinityEqualityCount];
    attribute stringEqualityCount = if ("a" == "a") ? 7 else 9;
    part stringEquality [stringEqualityCount];
    attribute nullEqualityCount = if (null == null) ? 7 else 9;
    part nullEquality [nullEqualityCount];
    attribute missingEqualityCount = if (missing == 1) ? 7 else 9;
    part missingEquality [missingEqualityCount];
    attribute undefinedEqualityCount = if (1 / 0 == 2) ? 7 else 9;
    part undefinedEquality [undefinedEqualityCount];
    attribute excessiveEqualityCount = if (2 ^ 1000000 == 2 ^ 1000000) ? 7 else 9;
    part excessiveEquality [excessiveEqualityCount];
    attribute notNumberCount = if (not 1) ? 7 else 9;
    part notNumber [notNumberCount];
    attribute andNumberCount = if (true & 1) ? 7 else 9;
    part andNumber [andNumberCount];
    attribute orNumberCount = if (false | 1) ? 7 else 9;
    part orNumber [orNumberCount];
    attribute xorNumberCount = if (false xor 1) ? 7 else 9;
    part xorNumber [xorNumberCount];
    attribute eagerAndCount = if (false & missing) ? 7 else 9;
    part eagerAnd [eagerAndCount];
    attribute eagerOrCount = if (true | missing) ? 7 else 9;
    part eagerOr [eagerOrCount];
    attribute eagerXorCount = if (true xor missing) ? 7 else 9;
    part eagerXor [eagerXorCount];
    attribute neededAndCount = if (true and missing) ? 7 else 9;
    part neededAnd [neededAndCount];
    attribute neededOrCount = if (false or missing) ? 7 else 9;
    part neededOr [neededOrCount];
    attribute neededImpliesCount = if (true implies missing) ? 7 else 9;
    part neededImplies [neededImpliesCount];
    attribute badFirstCount = if (1 and false) ? 7 else 9;
    part badFirst [badFirstCount];
    attribute badSecondCount = if (true implies 1) ? 7 else 9;
    part badSecond [badSecondCount];
    attribute eagerDivisionCount = if (false & (1 / 0 == 2)) ? 7 else 9;
    part eagerDivision [eagerDivisionCount];
    attribute selectedDivisionCount = if (true and (1 / 0 == 2)) ? 7 else 9;
    part selectedDivision [selectedDivisionCount];
    attribute recursiveCount = if (false and cycleA) ? 7 else 9;
    part recursive [recursiveCount];
    attribute booleanBoundValue = 3 == 3;
    part booleanBound [booleanBoundValue];
    attribute logicalBoundValue = true and false;
    part logicalBound [logicalBoundValue];
}
