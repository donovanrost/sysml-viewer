package CoalescingValues {
    attribute missing;
    attribute empty = null;
    alias emptyAlias for empty;
    attribute value = 3;
    alias valueAlias for value;
    attribute literalNullCount = null ?? 7;
    part literalNull [literalNullCount];
    attribute emptyParenthesesCount = () ?? 7;
    part emptyParentheses [emptyParenthesesCount];
    attribute presentIntegerCount = 3 ?? 7;
    part presentInteger [presentIntegerCount];
    attribute presentZeroCount = 0 ?? 7;
    part presentZero [presentZeroCount];
    attribute falsePresentCount = if (false ?? true) ? 7 else 9;
    part falsePresent [falsePresentCount];
    attribute truePresentCount = if (true ?? false) ? 7 else 9;
    part truePresent [truePresentCount];
    attribute nullBooleanCount = if (null ?? true) ? 7 else 9;
    part nullBoolean [nullBooleanCount];
    attribute rationalPresentCount = if ((3 / 2) ?? 9) == (6 / 4) ? 7 else 9;
    part rationalPresent [rationalPresentCount];
    attribute viaAliasCount = emptyAlias ?? 7;
    part viaAlias [viaAliasCount];
    attribute viaValueAliasCount = valueAlias ?? 7;
    part viaValueAlias [viaValueAliasCount];
    attribute nestedEmptyCount = (null ?? ()) ?? 7;
    part nestedEmpty [nestedEmptyCount];
    attribute nestedFallbackCount = null ?? (null ?? 7);
    part nestedFallback [nestedFallbackCount];
    attribute conditionalEmptyCount = (if true ? null else 3) ?? 7;
    part conditionalEmpty [conditionalEmptyCount];
    attribute conditionalPresentCount = (if false ? null else 3) ?? 7;
    part conditionalPresent [conditionalPresentCount];
    attribute skippedMissingCount = 3 ?? missing;
    part skippedMissing [skippedMissingCount];
    attribute skippedDivisionCount = 3 ?? (1 / 0);
    part skippedDivision [skippedDivisionCount];
    attribute skippedOverflowCount = 3 ?? (2 ^ 1000000);
    part skippedOverflow [skippedOverflowCount];
    attribute skippedRealCount = 3 ?? 1.5;
    part skippedReal [skippedRealCount];
    attribute skippedNullCount = 3 ?? null;
    part skippedNull [skippedNullCount];
    attribute arithmeticFallbackCount = null ?? (2 + 5);
    part arithmeticFallback [arithmeticFallbackCount];
    attribute composedArithmeticCount = (null ?? 3) + 4;
    part composedArithmetic [composedArithmeticCount];
    attribute composedLogicalCount = if ((null ?? false) or true) ? 7 else 9;
    part composedLogical [composedLogicalCount];
    attribute largeExactCount = 9007199254740993 ?? 1;
    part largeExact [largeExactCount];
    attribute conditionalSkipCount = if true ? (null ?? 7) else missing;
    part conditionalSkip [conditionalSkipCount];
}
