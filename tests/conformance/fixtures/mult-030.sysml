package CoalescingGuards {
    attribute missing;
    attribute cycleA = cycleB;
    attribute cycleB = cycleA;
    attribute missingFirstCount = missing ?? 7;
    part missingFirst [missingFirstCount];
    attribute selectedMissingCount = null ?? missing;
    part selectedMissing [selectedMissingCount];
    attribute undefinedFirstCount = (1 / 0) ?? 7;
    part undefinedFirst [undefinedFirstCount];
    attribute selectedDivisionCount = null ?? (1 / 0);
    part selectedDivision [selectedDivisionCount];
    attribute overflowFirstCount = (2 ^ 1000000) ?? 7;
    part overflowFirst [overflowFirstCount];
    attribute bothEmptyCount = null ?? ();
    part bothEmpty [bothEmptyCount];
    attribute bareEmptyCount = null;
    part bareEmpty [bareEmptyCount];
    attribute booleanEndpointCount = false ?? 7;
    part booleanEndpoint [booleanEndpointCount];
    attribute fractionalEndpointCount = (3 / 2) ?? 7;
    part fractionalEndpoint [fractionalEndpointCount];
    attribute negativeEndpointCount = (-1) ?? 7;
    part negativeEndpoint [negativeEndpointCount];
    attribute realFirstCount = 1.5 ?? 7;
    part realFirst [realFirstCount];
    attribute selectedRealCount = null ?? 1.5;
    part selectedReal [selectedRealCount];
    attribute stringFirstCount = "a" ?? 7;
    part stringFirst [stringFirstCount];
    attribute sequenceFirstCount = (1, 2) ?? 7;
    part sequenceFirst [sequenceFirstCount];
    attribute selectedSequenceCount = null ?? (1, 2);
    part selectedSequence [selectedSequenceCount];
    attribute recursiveFirstCount = cycleA ?? 7;
    part recursiveFirst [recursiveFirstCount];
    attribute recursiveSkippedCount = 3 ?? cycleA;
    part recursiveSkipped [recursiveSkippedCount];
    attribute emptyUnaryPlusCount = (+null) ?? 7;
    part emptyUnaryPlus [emptyUnaryPlusCount];
    attribute emptyArithmeticCount = (null + 1) ?? 7;
    part emptyArithmetic [emptyArithmeticCount];
    attribute emptyEqualityCount = if (null == null) ? 7 else 9;
    part emptyEquality [emptyEqualityCount];
    attribute emptyConditionCount = if (null ?? ()) ? 7 else 9;
    part emptyCondition [emptyConditionCount];
    attribute overflowEndpointCount = 2 ^ 1000000;
    part overflowEndpoint [overflowEndpointCount];
    attribute underflowFirstCount = (2 ^ (-1000000)) ?? 7;
    part underflowFirst [underflowFirstCount];
    attribute irrationalFirstCount = (2 ^ (1 / 2)) ?? 7;
    part irrationalFirst [irrationalFirstCount];
}
