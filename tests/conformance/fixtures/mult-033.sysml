package StringValues {
    attribute missing;
    attribute text = "port";
    alias textAlias for text;
    attribute eqEqualCount = if ("port" == "port") ? 7 else 9;
    part eqEqual [eqEqualCount];
    attribute eqCaseCount = if ("Port" == "port") ? 7 else 9;
    part eqCase [eqCaseCount];
    attribute eqEmptyCount = if ("" == "") ? 7 else 9;
    part eqEmpty [eqEmptyCount];
    attribute neEqualCount = if ("port" != "port") ? 7 else 9;
    part neEqual [neEqualCount];
    attribute neCaseCount = if ("Port" != "port") ? 7 else 9;
    part neCase [neCaseCount];
    attribute neEmptyCount = if ("" != "") ? 7 else 9;
    part neEmpty [neEmptyCount];
    attribute sameEqualCount = if ("port" === "port") ? 7 else 9;
    part sameEqual [sameEqualCount];
    attribute sameCaseCount = if ("Port" === "port") ? 7 else 9;
    part sameCase [sameCaseCount];
    attribute sameEmptyCount = if ("" === "") ? 7 else 9;
    part sameEmpty [sameEmptyCount];
    attribute differentEqualCount = if ("port" !== "port") ? 7 else 9;
    part differentEqual [differentEqualCount];
    attribute differentCaseCount = if ("Port" !== "port") ? 7 else 9;
    part differentCase [differentCaseCount];
    attribute differentEmptyCount = if ("" !== "") ? 7 else 9;
    part differentEmpty [differentEmptyCount];
    attribute unicodeCount = if ("海🚢" == "海🚢") ? 7 else 9;
    part unicode [unicodeCount];
    attribute distinctUnicodeCount = if ("é" != "é") ? 7 else 9;
    part distinctUnicode [distinctUnicodeCount];
    attribute escapedBackslashCount = if ("\\n" != "\n") ? 7 else 9;
    part escapedBackslash [escapedBackslashCount];
    attribute escapedQuoteCount = if (("\"" + "port") == "\"port") ? 7 else 9;
    part escapedQuote [escapedQuoteCount];
    attribute allEscapesCount = if (("\b\f\t" + "\n\'\\") == "\b\f\t\n\'\\") ? 7 else 9;
    part allEscapes [allEscapesCount];
    attribute concatenateCount = if (("sys" + "ml") === "sysml") ? 7 else 9;
    part concatenate [concatenateCount];
    attribute unicodeConcatenateCount = if (("海" + "🚢") == "海🚢") ? 7 else 9;
    part unicodeConcatenate [unicodeConcatenateCount];
    attribute nestedConcatenateCount = if (("a" + ("b" + "c")) == "abc") ? 7 else 9;
    part nestedConcatenate [nestedConcatenateCount];
    attribute emptyConcatenateCount = if (("" + "a" + "") == "a") ? 7 else 9;
    part emptyConcatenate [emptyConcatenateCount];
    attribute viaAliasCount = if (textAlias == "port") ? 7 else 9;
    part viaAlias [viaAliasCount];
    attribute nullRightCount = if ("" == null) ? 7 else 9;
    part nullRight [nullRightCount];
    attribute nullLeftCount = if (null !== "") ? 7 else 9;
    part nullLeft [nullLeftCount];
    attribute emptyStringPresentCount = if (("" ?? "fallback") == "") ? 7 else 9;
    part emptyStringPresent [emptyStringPresentCount];
    attribute nullFallbackCount = if ((null ?? "port") == "port") ? 7 else 9;
    part nullFallback [nullFallbackCount];
    attribute skipMissingCount = if (("port" ?? missing) == "port") ? 7 else 9;
    part skipMissing [skipMissingCount];
    attribute selectedStringCount = if ((if true ? "port" else missing) == "port") ? 7 else 9;
    part selectedString [selectedStringCount];
    attribute logicalSkipCount = if (("a" == "a") or missing) ? 7 else 9;
    part logicalSkip [logicalSkipCount];
}
