package StringGuards {
    attribute missing;
    attribute cycleA = cycleB;
    attribute cycleB = cycleA;
    attribute stringEndpointCount = "7";
    part stringEndpoint [stringEndpointCount];
    attribute concatEndpointCount = "3" + "4";
    part concatEndpoint [concatEndpointCount];
    attribute stringConditionCount = if "" ? 7 else 9;
    part stringCondition [stringConditionCount];
    attribute unaryPlusCount = if (+"a" == "a") ? 7 else 9;
    part unaryPlus [unaryPlusCount];
    attribute unaryMinusCount = if (-"a" == "a") ? 7 else 9;
    part unaryMinus [unaryMinusCount];
    attribute subtractCount = if (("a" - "a") == "") ? 7 else 9;
    part subtract [subtractCount];
    attribute numberConcatCount = if (("a" + 1) == "a1") ? 7 else 9;
    part numberConcat [numberConcatCount];
    attribute boolConcatCount = if ((false + "a") == "falsea") ? 7 else 9;
    part boolConcat [boolConcatCount];
    attribute nullConcatCount = if ((null + "a") == "a") ? 7 else 9;
    part nullConcat [nullConcatCount];
    attribute sequenceConcatCount = if ((("a", "b") + "c") == "abc") ? 7 else 9;
    part sequenceConcat [sequenceConcatCount];
    attribute numberEqualityCount = if ("1" == 1) ? 7 else 9;
    part numberEquality [numberEqualityCount];
    attribute boolEqualityCount = if (false !== "false") ? 7 else 9;
    part boolEquality [boolEqualityCount];
    attribute missingRightCount = if ("a" == missing) ? 7 else 9;
    part missingRight [missingRightCount];
    attribute missingLeftCount = if (missing !== "a") ? 7 else 9;
    part missingLeft [missingLeftCount];
    attribute selectedMissingCount = if (("a" + missing) == "a") ? 7 else 9;
    part selectedMissing [selectedMissingCount];
    attribute recursiveCount = if (("a" ?? cycleA) == "a") ? 7 else 9;
    part recursive [recursiveCount];
    attribute lessCount = if ("a" < "b") ? 7 else 9;
    part less [lessCount];
    attribute lessEqualCount = if ("a" <= "b") ? 7 else 9;
    part lessEqual [lessEqualCount];
    attribute greaterCount = if ("a" > "b") ? 7 else 9;
    part greater [greaterCount];
    attribute greaterEqualCount = if ("a" >= "b") ? 7 else 9;
    part greaterEqual [greaterEqualCount];
}
