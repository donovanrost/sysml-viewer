{
  "version": 1,
  "standards": {
    "SysML 2.0": {
      "document": "formal/2026-03-02",
      "url": "https://www.omg.org/spec/SysML/2.0/Language/PDF"
    },
    "KerML 1.0": {
      "document": "formal/2026-03-01",
      "url": "https://www.omg.org/spec/KerML/1.0/PDF"
    }
  },
  "areas": [
    {
      "id": "imports",
      "title": "Imports and visibility",
      "clauses": [
        {
          "standard": "SysML 2.0",
          "section": "7.5.2"
        },
        {
          "standard": "SysML 2.0",
          "section": "7.5.3"
        },
        {
          "standard": "KerML 1.0",
          "section": "7.2.5.4"
        }
      ],
      "uncovered": "Recursive and filtered imports, protected visibility, import-all interactions and complete membership enumeration remain unqualified."
    },
    {
      "id": "typing",
      "title": "Typing",
      "clauses": [
        {
          "standard": "SysML 2.0",
          "section": "7.6.3"
        },
        {
          "standard": "KerML 1.0",
          "section": "7.3.4.3"
        }
      ],
      "uncovered": "Multiple and implicit typing, chained types and all type-kind constraints need further cases."
    },
    {
      "id": "specialization",
      "title": "Specialization and inheritance",
      "clauses": [
        {
          "standard": "SysML 2.0",
          "section": "7.6.2"
        },
        {
          "standard": "KerML 1.0",
          "section": "7.3.2.3"
        }
      ],
      "uncovered": "Diamond coverage is limited to a common ancestor; conflicts, cycles and all inherited memberships require broader qualification."
    },
    {
      "id": "subsetting",
      "title": "Subsetting",
      "clauses": [
        {
          "standard": "SysML 2.0",
          "section": "7.6.3"
        },
        {
          "standard": "KerML 1.0",
          "section": "7.3.4.4"
        }
      ],
      "uncovered": "These cases check target identity, not instance-value containment or every conformance constraint."
    },
    {
      "id": "redefinition",
      "title": "Redefinition",
      "clauses": [
        {
          "standard": "SysML 2.0",
          "section": "7.6.3"
        },
        {
          "standard": "KerML 1.0",
          "section": "7.3.4.5"
        }
      ],
      "uncovered": "Direction, multiplicity, featuring-type conformance and nested redefinitions need additional cases."
    },
    {
      "id": "multiplicity",
      "title": "Multiplicity",
      "clauses": [
        {
          "standard": "SysML 2.0",
          "section": "7.6.3"
        },
        {
          "standard": "KerML 1.0",
          "section": "7.3.4.2"
        }
      ],
      "uncovered": "Only literal declared bounds are asserted; expression bounds, effective defaults and containment are unqualified."
    },
    {
      "id": "ports",
      "title": "Conjugated port typing",
      "clauses": [
        {
          "standard": "SysML 2.0",
          "section": "7.12.3"
        }
      ],
      "uncovered": "These assertions cover written references, not conjugated direction/flow semantics."
    },
    {
      "id": "connections",
      "title": "Connections and chains",
      "clauses": [
        {
          "standard": "SysML 2.0",
          "section": "7.6.6"
        },
        {
          "standard": "SysML 2.0",
          "section": "7.13.2"
        }
      ],
      "uncovered": "Endpoint identity and arity are covered; direction, flow compatibility and connection end conformance need further cases."
    },
    {
      "id": "source",
      "title": "Names and source fidelity",
      "clauses": [
        {
          "standard": "KerML 1.0",
          "section": "8.2.2"
        }
      ],
      "uncovered": "Byte/UTF-16 mapping and recovery are project API guarantees; lexical names are the standards link. No editable CST contract is claimed."
    },
    {
      "id": "robustness",
      "title": "Cyclic input handling",
      "clauses": [
        {
          "standard": "KerML 1.0",
          "section": "7.2.5.4"
        },
        {
          "standard": "KerML 1.0",
          "section": "7.3.2.3"
        }
      ],
      "uncovered": "Termination is an operational guarantee, not a semantic verdict about every cycle. Continuous fuzzing remains separate work."
    }
  ],
